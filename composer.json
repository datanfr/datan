{
    "name": "datanfr/datan",
    "description": "Datan - analyse du comportement de vote des députés français",
    "license": "GPL-3.0-only",
    "type": "project",
    "homepage": "https://datan.fr",
    "support": {
        "source": "https://github.com/datanfr/datan"
    },
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "codeigniter4/framework": "^4.6",
        "mailjet/mailjet-apiv3-php": "^1.6",
        "qferr/mjml-php": "^1.1",
        "pfaciana/tiny-html-minifier": "^3.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mikey179/vfsstream": "^1.6.12",
        "phpunit/phpunit": "^10.5.16 || ^11.2"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
