# Réécriture d'URL pour Apache et LiteSpeed (l'hébergement de production tourne
# sous LiteSpeed, qui lit les .htaccess). Sans ce fichier, seuls les fichiers
# réellement présents sur le disque sont servis : /robots.txt répond, mais
# /vote/17/491 et toutes les autres routes tombent sur le 404 du serveur web
# sans jamais atteindre Symfony.
#
# Contenu de symfony/apache-pack, que nous n'installons pas comme dépendance :
# le fichier ne change jamais et le paquet n'apporte rien d'autre.

# ---------------------------------------------------------------------------
# PHP 8.4 pour ce seul dossier. Le compte o2switch est celui de datan.fr, que
# le sélecteur de cPanel règle pour tout l'hébergement — legacy compris, en
# 7.4. Un .htaccess fixe la version du dossier qui le porte, et celui-ci est la
# racine web du sous-domaine (current/public) : datan.fr n'en voit rien.
#
# Forme « ___lsphp » (trois tirets bas) et non « x-httpd-php84 » : c'est le SAPI
# natif de LiteSpeed, sans la perte de vitesse de l'autre forme, et la seule qui
# donne PHP 8.4 (faq.o2switch.fr, « Version de PHP par dossier »). Contrepartie
# sans effet ici : php_value et .user.ini y sont ignorés.
#
# PIÈGE : un handler inconnu ne lève aucune erreur, le serveur rend le .php EN
# CLAIR — vérifié le 2026-10-23 avec `alt-php85___lsphp`, absent du serveur.
# C'est pourquoi le contrôle final du workflow de déploiement refuse une réponse
# qui contient « <?php ».
#
# Pas d'enveloppe <IfModule LiteSpeed> : elle était prise pour fausse sur ce
# serveur (« o2switch-PowerBoost-v3 »), et la ligne ignorée sans un mot — la
# page sortait en 7.4. La forme `<FilesMatch> SetHandler` répond, elle, par une
# page d'erreur.
#
# Ce handler lit le php.ini par défaut de /opt/alt/php84, pas les extensions
# cochées dans le sélecteur PHP : `intl` et `dom` y manquaient le 2026-10-23.
# Le jour où le compte entier passe en 8.4 par le sélecteur, RETIRER cette
# ligne, sans quoi elle continue de court-circuiter les extensions qu'on y
# coche.
# ---------------------------------------------------------------------------
AddHandler application/x-httpd-alt-php84___lsphp .php

# ---------------------------------------------------------------------------
# PRÉPRODUCTION : mot de passe sur tout le site, et non-indexation.
#
# À RETIRER le jour de la bascule sur datan.fr, avec le secret HTTP_AUTH du
# workflow de déploiement (checklist de TODO.md). Le bloc n'est pas conditionné
# à l'hôte servi, contrairement au garde-fou applicatif (App\Referencement\
# Indexation) : dans un .htaccess, seuls « Require env » et « Require expr »
# le permettraient, et LiteSpeed — le serveur de l'hébergement N0C — les ignore
# sans un mot. Un verrou qui pourrait ne pas s'appliquer en silence est pire
# qu'un verrou à retirer à la main.
#
# Le fichier de mots de passe vit hors de public/ et hors du dépôt, à côté de
# .env.local (~/symfony.datan.fr/.htpasswd). AuthUserFile veut un chemin absolu, qui dépend du compte :
# bin/deployer.sh réécrit la ligne ci-dessous dans chaque version, et refuse de
# déployer si le fichier manque — LiteSpeed répondrait 500 partout. Hachage apr1
# (« openssl passwd -apr1 »), le seul format que LiteSpeed et Apache lisent
# tous deux ; le serveur n'a pas « htpasswd ». Ajouter un compte :
#   printf 'nom:%s\n' "$(openssl passwd -apr1)" >> ~/symfony.datan.fr/.htpasswd
#
# /robots.txt n'est pas exempté, bien qu'un « Disallow: / » lisible sans mot de
# passe serait plus net. L'adresse est réécrite vers index.php, et LiteSpeed
# applique <FilesMatch> au fichier final ; il ignore « Allow from env= » comme
# « Require env » (vérifié sur le serveur en septembre 2026). Un robots.txt en
# 401 vaut pour un moteur une absence de fichier : il tente les pages, qui
# répondent 401 elles aussi — rien ne s'indexe.
# ---------------------------------------------------------------------------
AuthType Basic
AuthName "Datan - preproduction"
AuthUserFile /remplace/par/bin/deployer.sh/.htpasswd
Require valid-user

# L'application pose déjà cet en-tête sur tout ce qu'elle rend
# (App\Referencement\EnTeteRobots). Ici il couvre ce que LiteSpeed sert sans
# passer par PHP : les fichiers de public/ — images, feuilles de style,
# documents PDF.
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

DirectoryIndex index.php

# MultiViews ferait deviner au serveur l'extension d'un fichier absent et
# court-circuiterait la règle de réécriture finale.
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS partout (recette de faq.o2switch.fr, « Forcer le HTTPS »). Hors
    # validation Let's Encrypt, qu'une redirection fait échouer : son dossier a
    # son propre .htaccess, et la condition sur l'URI double ce garde-fou.
    # Limite connue : le mot de passe de préproduction est demandé avant cette
    # redirection, donc en clair sur http:// — entrer par https://.
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Détermine le préfixe d'URL sous lequel l'application est servie, pour que
    # les règles suivantes fonctionnent aussi dans un sous-répertoire.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Certains serveurs n'exposent pas l'en-tête Authorization à PHP : sans
    # cette règle, l'authentification par jeton se perd en route.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Une même page ne doit pas répondre à deux adresses : /index.php/truc
    # redirige en 301 vers /truc. Le référencement de datan.fr en dépend.
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Un fichier qui existe (assets, robots.txt, images) est servi tel quel.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tout le reste passe par le contrôleur frontal.
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
