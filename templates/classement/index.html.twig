{% extends 'base.html.twig' %}

{% block title %}Statistiques et classements - Assemblée nationale | Datan{% endblock %}

{% block meta_description %}Classements des députés et des groupes. {% endblock %}

{% macro lien_classement(page) %}
  <a href="{{ path('classement_individual', {page: page}) }}" class="no-decoration">
    <div class="card-footer text-center">
      <span>Découvrez tout le classement</span>
    </div>
  </a>
{% endmacro %}

{% block body %}
{% import _self as bloc %}
<div class="container pg-stats-index mb-5">
  <div class="row bloc-titre">
    <div class="col-md-12">
      <h1>{{ title }}</h1>
    </div>
    <div class="col-md-8 col-lg-7">
      <div class="mt-4">
        <p>
          Quel député vote le plus ? Qui vote le plus souvent comme son groupe ? Quel groupe parlementaire est le plus divisé ? Ou encore quel député est le plus âgé ?
        </p>
        <p>
          L'équipe de <b>Datan</b> vous propose une série de classements qui répondent à ces questions. Et si vous avez d'autres idées, n'hésitez pas à nous contacter : info[at]datan.fr !
        </p>
        <p>
          Pour en savoir plus sur nos statistiques, <a href="{{ path('page_statistiques') }}">cliquez ici</a>.
        </p>
        {{ include('partials/campagne.html.twig', {classes: 'mt-5'}) }}
      </div>
    </div>
    <div class="col-md-4 offset-lg-1 d-none d-md-flex align-items-start">
      <div class="p-4">
        <img class="img-fluid" src="{{ asset('assets/imgs/svg/undraw_visual_data_b1wx_2.svg') }}" alt="">
      </div>
    </div>
  </div>

  <!-- AGE -->
  <div class="row">
    <div class="col-12">
      <div class="title_svg">
        <h2>L'âge des députés</h2>
        {{ include('classement/partials/blob.html.twig', {numero: 1}) }}
      </div>
    </div>
  </div>
  <div class="row bloc-ranking mt-5">
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0">
      <div class="card">
        <div class="card-body">
          <h3>Les plus âgés ? Les plus jeunes ?</h3>
          <p>L'âge moyen des députés est de <b>{{ age_moyen|round(1) }} ans</b>. Découvrez dans ce tableau les trois députés les plus âgés et les trois députés les plus jeunes.</p>
          <div class="table_ranking mt-4">
            <table class="table table-striped">
              <caption class="sr-only">L'âge moyen des députés</caption>
              <thead>
                <tr>
                  <td></td>
                  <th scope="col">Député</th>
                  <th scope="col">Âge</th>
                </tr>
              </thead>
              <tbody>
                {% for depute in deputes_plus_ages %}
                  <tr>
                    <th scope="row">{{ depute.rang }}</th>
                    <td>
                      <a href="{{ path('depute_individual', {dptSlug: depute.dpt_slug, slug: depute.slug}) }}" class="no-decoration underline">{{ depute.firstname }} {{ depute.lastname }} ({{ depute.groupe_abrev }})</a>
                    </td>
                    <td>{{ depute.score_arrondi }} ans</td>
                  </tr>
                {% endfor %}
                <tr>
                  <td colspan="3" class="text-center">...</td>
                </tr>
                {% for depute in deputes_plus_jeunes %}
                  <tr>
                    <th scope="row">{{ depute.rang }}</th>
                    <td>
                      <a href="{{ path('depute_individual', {dptSlug: depute.dpt_slug, slug: depute.slug}) }}" class="no-decoration underline">{{ depute.firstname }} {{ depute.lastname }} ({{ depute.groupe_abrev }})</a>
                    </td>
                    <td>{{ depute.score_arrondi }} ans</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        {{ bloc.lien_classement('deputes-age') }}
      </div>
    </div>
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0 mt-5 mt-lg-0">
      <div class="card">
        {% if groupes_age %}
          <div class="card-body pb-0">
            <h3>La moyenne d'âge par groupe</h3>
            <p>Découvrez le groupe politique ayant la moyenne d'âge la plus élevée et celui avec la moyenne d'âge la plus faible.</p>
            {{ include('classement/partials/duo_groupes.html.twig', {duo: groupes_age}) }}
          </div>
          {{ bloc.lien_classement('groupes-age') }}
        {% else %}
          <div class="card-body">
            <h3>La moyenne d'âge par groupe</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- FEMMES -->
  <div class="row mt-5">
    <div class="col-12">
      <div class="title_svg">
        <h2>Les femmes à l'Assemblée nationale</h2>
        {{ include('classement/partials/blob.html.twig', {numero: 2}) }}
      </div>
    </div>
  </div>
  <div class="row bloc-ranking mt-5">
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0">
      <div class="card">
        <div class="card-body pb-0">
          <h3>L'évolution du taux de députées femmes</h3>
          <div class="mt-lg-3">
            <p>
              Actuellement, il y a <b>{{ femmes.nombre }}</b> femmes députées à l'Assemblée nationale.
              Cela représente <b>{{ femmes.pourcentage }} %</b> des effectifs des parlementaires.
            </p>
            <p>
              Entre la législature précédente et la législature actuelle, le nombre de femmes députées {{ femmes_evolution }}.
            </p>
          </div>
          <div class="row mt-lg-3 bar-container stats pr-2">
            <div class="col-10 offset-2">
              <div class="chart">
                <div class="chart-grid">
                  <div id="ticks">
                    <div class="tick" style="height: 50%;"><p>100 %</p></div>
                    <div class="tick" style="height: 50%;"><p>50 %</p></div>
                    <div class="tick" style="height: 0;"><p>0 %</p></div>
                  </div>
                </div>
                <div class="bar-chart d-flex flex-row justify-content-between align-items-end">
                  {% for terme in femmes_historique %}
                    <div class="bars tooltipHelp mx-1 {{ loop.first ? 'd-none d-sm-flex' : 'd-flex' }}" style="height: {{ terme.pourcentage }}%" data-toggle="tooltip" data-placement="top" title="{{ terme.legislature }}e législature ({{ terme.debut }} - {{ terme.fin }})">
                      <span class="score">{{ terme.pourcentage }}%</span>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
            <div class="col-10 offset-2 d-flex justify-content-between mt-2">
              {% for terme in femmes_historique %}
                <div class="legend-element {{ loop.first ? 'd-none d-sm-flex' : 'd-flex' }} align-items-center justify-content-center text-center" data-toggle="tooltip" data-placement="bottom" title="{{ terme.legislature }}e législature ({{ terme.debut }} - {{ terme.fin }})">
                  <span class="tooltipHelp tooltipDashed">{{ terme.debut }}-{{ terme.fin[2:2] }}</span>
                </div>
              {% endfor %}
            </div>
          </div>
          <p class="mt-3">
            Le pourcentage de femmes députées a considérablement augmenté depuis le début de la Cinquième République. En 1958, l'Assemblée ne comptait parmi ses membres que 8 femmes, soit 1,4% des effectifs.
          </p>
        </div>
      </div>
    </div>
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0 mt-5 mt-lg-0">
      <div class="card">
        {% if groupes_femmes_plus %}
          <div class="card-body">
            <h3>La féminisation des groupes politiques</h3>
            <p>Certains groupes comptent dans leur rang plus de femmes que d'autres. Découvrez ici les groupes les féminisés et ceux qui le sont moins.</p>
            <div class="table_ranking">
              <table class="table table-striped">
                <caption class="sr-only">La féminisation des groupes politiques</caption>
                <thead>
                  <tr>
                    <td></td>
                    <th scope="col">Groupe</th>
                    <th scope="col">% de femmes</th>
                  </tr>
                </thead>
                <tbody>
                  {% for groupe in groupes_femmes_plus %}
                    <tr>
                      <th scope="row">{{ groupe.rang }}</th>
                      <td>{{ groupe.libelle|name_group }} ({{ groupe.libelle_abrev }})</td>
                      <td>{{ groupe.pourcentage }} %</td>
                    </tr>
                  {% endfor %}
                  <tr>
                    <td colspan="3" class="text-center">...</td>
                  </tr>
                  {% for groupe in groupes_femmes_moins %}
                    <tr>
                      <th scope="row">{{ groupe.rang }}</th>
                      <td>{{ groupe.libelle|name_group }} ({{ groupe.libelle_abrev }})</td>
                      <td>{{ groupe.pourcentage }} %</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
          {{ bloc.lien_classement('groupes-feminisation') }}
        {% else %}
          <div class="card-body">
            <h3>La féminisation des groupes politiques</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- LOYAUTE -->
  <div class="row mt-5">
    <div class="col-12">
      <div class="title_svg">
        <h2>La proximité au groupe politique</h2>
        {{ include('classement/partials/blob.html.twig', {numero: 3}) }}
      </div>
    </div>
  </div>
  <div class="row bloc-ranking mt-5">
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0">
      <div class="card">
        {% if deputes_plus_loyaux %}
          <div class="card-body">
            <h3>La proximité des députés à leur groupe</h3>
            <p>
              Quand ils votent, les députés peuvent décider de suivre la ligne de leur groupe politique. Ils peuvent également décider de voter contre leur groupe, par exemple si leur position personnelle est différente ou si les intérêts de leur circonscription sont contraires à la ligne du groupe.
            </p>
            <p>
              En moyenne, les députés votent avec leur groupe dans <b>{{ (loyaute_moyenne * 100)|round }} %</b> des cas.
            </p>
            <div class="table_ranking">
              <table class="table table-striped">
                <caption class="sr-only">La proximité des députés à leur groupe</caption>
                <thead>
                  <tr>
                    <td></td>
                    <th scope="col">Député</th>
                    <th scope="col">Taux de loyauté</th>
                  </tr>
                </thead>
                <tbody>
                  {% for depute in deputes_plus_loyaux %}
                    <tr>
                      <th scope="row">{{ depute.rang }}</th>
                      <td>{{ depute.firstname }} {{ depute.lastname }} ({{ depute.groupe_abrev }})</td>
                      <td>{{ depute.pourcentage }} %</td>
                    </tr>
                  {% endfor %}
                  <tr>
                    <td colspan="3" class="text-center">...</td>
                  </tr>
                  {% for depute in deputes_moins_loyaux %}
                    <tr>
                      <th scope="row">{{ depute.rang }}</th>
                      <td>{{ depute.firstname }} {{ depute.lastname }} ({{ depute.groupe_abrev }})</td>
                      <td>{{ depute.pourcentage }} %</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
          {{ bloc.lien_classement('deputes-loyaute') }}
        {% else %}
          <div class="card-body">
            <h3>La loyauté des députés envers leur groupe</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0 mt-5 mt-lg-0">
      <div class="card">
        {% if groupes_cohesion %}
          <div class="card-body pb-0">
            <h3>La cohésion au sein des groupes</h3>
            <p>
              Quand ils votent, les députés peuvent décider de suivre la ligne de leur groupe politique. Ils peuvent également décider de voter contre leur groupe, par exemple si leur position personnelle est différente ou si les intérêts de leur circonscription sont contraires à la ligne du groupe.
            </p>
            {{ include('classement/partials/duo_groupes.html.twig', {duo: groupes_cohesion}) }}
          </div>
          {{ bloc.lien_classement('groupes-cohesion') }}
        {% else %}
          <div class="card-body">
            <h3>La cohésion au sein des groupes</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- PARTICIPATION -->
  <div class="row mt-5">
    <div class="col-12">
      <div class="title_svg">
        <h2>La participation politique</h2>
        {{ include('classement/partials/blob.html.twig', {numero: 4}) }}
      </div>
    </div>
  </div>
  <div class="row bloc-ranking mt-5">
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0">
      <div class="card">
        {% if deputes_plus_actifs %}
          <div class="card-body">
            <h3>La participation des députés aux votes</h3>
            <p>En moyenne, les députés participent à <b>{{ (participation_moyenne * 100)|round }} %</b> des scrutins.</p>
            <div class="table_ranking">
              <table class="table table-striped">
                <caption class="sr-only">La participation des députés aux votes</caption>
                <thead>
                  <tr>
                    <td></td>
                    <th scope="col">Député</th>
                    <th scope="col">Taux de participation</th>
                  </tr>
                </thead>
                <tbody>
                  {% for depute in deputes_plus_actifs %}
                    <tr>
                      <th scope="row">{{ depute.rang }}</th>
                      <td>{{ depute.firstname }} {{ depute.lastname }} ({{ depute.groupe_abrev }})</td>
                      <td>{{ depute.pourcentage }} %</td>
                    </tr>
                  {% endfor %}
                  <tr>
                    <td colspan="3" class="text-center">...</td>
                  </tr>
                  {% for depute in deputes_moins_actifs %}
                    <tr>
                      <th scope="row">{{ depute.rang }}</th>
                      <td>{{ depute.firstname }} {{ depute.lastname }} ({{ depute.groupe_abrev }})</td>
                      <td>{{ depute.pourcentage }} %</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
          {{ bloc.lien_classement('deputes-participation') }}
        {% else %}
          <div class="card-body">
            <h3>La participation des députés aux votes</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0 mt-5 mt-lg-0">
      <div class="card">
        {% if groupes_participation %}
          <div class="card-body pb-0">
            <h3>La participation au sein des groupes</h3>
            <p>Quels sont les groups politiques ayant les députés participant le plus aux votes à l'Assemblée nationale ?</p>
            {{ include('classement/partials/duo_groupes.html.twig', {duo: groupes_participation}) }}
          </div>
          {{ bloc.lien_classement('groupes-participation') }}
        {% else %}
          <div class="card-body">
            <h3>La participation au sein des groupes</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- ORIGINE SOCIALE -->
  <div class="row mt-5">
    <div class="col-12">
      <div class="title_svg">
        <h2>L'origine sociale des députés</h2>
        {{ include('classement/partials/blob.html.twig', {numero: 1}) }}
      </div>
    </div>
  </div>
  <div class="row bloc-ranking mt-5">
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0 mt-5 mt-lg-0">
      <div class="card">
        {% if groupes_cadres %}
          <div class="card-body pb-0">
            <h3>La part de députés cadres dans chaque groupe politique</h3>
            <p>La grande majorité de parlementaires étaient cadres ou exerçaient une profession intellectuelle supérieure (par exemple avocat, médecin ou ingénieur).</p>
            <p>Découvrez le groupe politique qui compte le plus de députés cadres et celui en ayant le moins.</p>
            {{ include('classement/partials/duo_groupes.html.twig', {duo: groupes_cadres}) }}
          </div>
          {{ bloc.lien_classement('groupes-origine-sociale') }}
        {% else %}
          <div class="card-body">
            <h3>La part des députés cadres dans chaque groupe politique</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="col-lg-6 col-md-10 offset-md-1 offset-lg-0 mt-5 mt-lg-0">
      <div class="card">
        {% if groupes_rose %}
          <div class="card-body pb-0">
            <h3>La représentativité sociale des groupes politiques</h3>
            <p>Un groupe politique est-il représentatif de la population française ? Quel groupe politique ressemble le plus socialement à la population ?</p>
            <p>Nous utilisons un <a class="url_obf" href="https://rdrr.io/rforge/polrep/man/Rose.html" target="_blank" rel="nofollow noopener">indicateur</a> permettant de mesurer la représentation des groupes de l'Assemblée nationale. Il va de 0 (le moins représentatif) à 1 (le plus représentatif).</p>
            {{ include('classement/partials/duo_groupes.html.twig', {duo: groupes_rose}) }}
          </div>
          {{ bloc.lien_classement('groupes-origine-sociale') }}
        {% else %}
          <div class="card-body">
            <h3>La représentativité sociale des groupes politiques</h3>
            <p>Ces données seront prochainement disponibles.</p>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="col-12 mt-5">
      <div class="card">
        <div class="card-body">
          <h3>Les députés selon leur catégorie professionnelle</h3>
          <div class="row row-grid mt-5 mt-md-4">
            <div class="col-lg-4 d-flex flex-column justify-content-center">
              <p>
                Les députés sont-ils représentatifs de la population française ?
              </p>
              <p>
                La grande majorité des parlementaires sont cadres ou exercent une profession intellectuelle supérieure, par exemple avocat, médecin ou ingénieur. Ils représentent {{ famille_cadres.part|round }}% des députés, alors que seulement {{ famille_cadres.population|round }}% de la population française appartient à cette catégorie.
              </p>
              <p>
                Au contraire, <b>peu de députés sont employés ou ouvriers</b>, alors qu'ils représentent un tiers de la population.
              </p>
            </div>
            <div class="col-lg-8">
              <h4 class="text-center mb-4">Pourcentage de députés et de citoyens dans chaque catégorie</h4>
              <div style="min-height: 425px">
                <canvas id="chartOrigineSociale"></canvas>
              </div>
            </div>
          </div>
        </div>
        {{ bloc.lien_classement('deputes-origine-sociale') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('assets/js/dist/chart.min.js') }}"></script>
  <script>
    new Chart(document.getElementById('chartOrigineSociale'), {
      type: 'bar',
      data: {
        labels: {{ familles|column('lignes')|json_encode|raw }},
        datasets: [
          {
            label: 'Députés',
            data: {{ familles|column('part')|json_encode|raw }},
            borderColor: 'rgba(0, 183, 148, 1)',
            backgroundColor: 'rgba(0, 183, 148, 1)'
          },
          {
            label: 'Population',
            data: {{ familles|column('population')|json_encode|raw }},
            borderColor: 'rgba(255, 102, 26, 1)',
            backgroundColor: 'rgba(255, 102, 26, 1)'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        tooltips: {
          callbacks: {
            label: function (tooltipItem, data) {
              return data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index] + ' %';
            }
          }
        },
        plugins: {
          datalabels: { display: false }
        }
      }
    });
  </script>
{% endblock %}
