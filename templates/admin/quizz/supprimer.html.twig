{% extends 'admin/base.html.twig' %}

{% block title %}Supprimer une question{% endblock %}

{% block body %}
  <div class="card">
    <div class="card-body">
      <p>Supprimer définitivement la question « <strong>{{ question.titre }}</strong> » ?</p>
    </div>
    <div class="card-footer d-flex justify-content-between">
      <a class="btn btn-secondary" href="{{ path('admin_quizz_index') }}">Annuler</a>
      <form action="{{ path('admin_quizz_supprimer', {id: question.id}) }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_quizz_' ~ question.id) }}">
        <button type="submit" class="btn btn-danger">Supprimer</button>
      </form>
    </div>
  </div>
{% endblock %}
