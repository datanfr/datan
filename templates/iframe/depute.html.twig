{# Fiche de député embarquable, portée de iframe/depute.php + iframe/partials/*.
   Document AUTONOME : ni base.html.twig, ni barre de navigation, ni pied de page
   de site — une iframe n'embarque que le contenu. Aucun en-tête X-Frame-Options
   ni CSP frame-ancestors n'est posé (voir IframeController), la réponse reste
   encadrable. Pistage et bannière de consentement volontairement absents : les
   injecter chez un tiers serait un défaut. #}
<!DOCTYPE html>
<html lang="fr" dir="ltr" prefix="og: http://ogp.me/ns#">
<head>
  <meta charset="utf-8">
  {# Document autonome : il ne profite pas de la bascule de base.html.twig et
     porte la sienne. #}
  <meta name="robots" content="{{ site_indexable() ? 'index,follow' : 'noindex, nofollow, noarchive' }}">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>{{ depute.firstname }} {{ depute.lastname }} - Activité Parlementaire | Datan</title>
  <meta name="description" content="Découvrez les résultats des votes de {{ accord == 'e' ? 'la' : 'le' }} {{ depute_mot }} {{ depute.firstname }} {{ depute.lastname }} : taux de participation, loyauté avec son groupe.">
  <meta name="theme-color" content="#00668e">
  <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/main.css') }}">
  {# Flickity habille le carrousel des derniers votes ; sa feuille doit précéder
     main.min.js, qui l'initialise sur `.carousel-container`. #}
  <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/flickity.min.css') }}">
  {# Jauges circulaires (.c100 pNN) : feuille séparée de main.css, sans elle les
     pourcentages sortent en texte nu — même chargement que la fiche publique. #}
  <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/circle.css') }}">
  {# Open Sans, la police de tout le site. Ce document étant autonome, il ne
     profite pas de la déclaration de base.html.twig : sans elle, main.css demande
     une famille que le navigateur n'a pas et retombe sur une sérif locale — toute
     l'iframe change alors d'allure chez le tiers qui l'embarque. Même bloc que
     base.html.twig, et que le `_header_iframe.php` de l'origine, qui charge lui
     aussi ces trois graisses depuis fonts.gstatic.com. #}
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
  <style media="screen">
    @font-face {
      font-family: 'Open Sans';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: local('Open Sans Regular'), local('OpenSans-Regular'), url(https://fonts.gstatic.com/s/opensans/v17/mem8YaGs126MiZpBA-UFVZ0bf8pkAg.woff2) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Open Sans';
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: local('Open Sans SemiBold'), local('OpenSans-SemiBold'), url(https://fonts.gstatic.com/s/opensans/v17/mem5YaGs126MiZpBA-UNirkOUuhpKKSTjw.woff2) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Open Sans';
      font-style: normal;
      font-weight: 800;
      font-display: swap;
      src: local('Open Sans ExtraBold'), local('OpenSans-ExtraBold'), url(https://fonts.gstatic.com/s/opensans/v17/mem5YaGs126MiZpBA-UN8rsOUuhpKKSTjw.woff2) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  </style>
</head>
<body>
  <main>
    <div class="pg-depute-individual iframe-container {{ titre_principal_visible ? '' : 'no-title' }} {{ sous_titres_visibles ? '' : 'no-subtitle' }}">
      {% if titre_principal_visible %}
        <h1>
          {%- if premiere_personne %}Mon activité de {{ depute_mot }}
          {%- else %}L'activité de {{ depute_mot }} de {{ depute.firstname }} {{ depute.lastname }}{% endif -%}
        </h1>
      {% endif %}

      {% for bloc in blocs %}

        {# Sélection éditoriale figée des scrutins marquants, mise en forme comme
           sur la fiche — l'origine y charge le même partial. Les intitulés
           basculent à la première personne sous ?first-person=true. #}
        {% if bloc == 'positions-importantes' %}
          {{ include('iframe/_positions.html.twig') }}
        {% endif %}

        {% if bloc == 'derniers-votes' and carrousel_votes %}
          {# Carrousel des scrutins DÉCRYPTÉS où le député s'est exprimé, mêmes
             cartes que la fiche (`depute/_carte_vote.html.twig`, lecture partagée
             via ComportementDepute). Flickity l'initialise via main.min.js. #}
          <div class="bloc-votes mt-5">
            {# En-tête du carrousel : titre à gauche, bouton « VOIR TOUS » à droite,
               comme la fiche et comme `_votes.php`. Titre masqué, le bouton reste
               et se colle à droite (`justify-content-end` de l'origine) — sans quoi
               il se centrerait. #}
            <div class="d-flex {{ sous_titres_visibles ? 'justify-content-between' : 'justify-content-end' }} mb-4">
              {% if sous_titres_visibles %}
                <h2 class="title-center mb-0">{{ possessif_pluriel }} derniers votes</h2>
              {% endif %}
              <div class="bloc-carousel-votes">
                <a class="btn see-all-votes mx-2" href="{{ path('depute_votes', {dptSlug: depute.dpt_slug, slug: depute.slug}) }}"><span>VOIR TOUS</span></a>
              </div>
            </div>
            <div class="carousel-container bloc-carousel-votes-flickity">
              <div class="carousel-cards">
                {% for vote in carrousel_votes %}
                  {{ include('depute/_carte_vote.html.twig') }}
                {% endfor %}
                <div class="card card-vote see-all">
                  <div class="card-body d-flex align-items-center justify-content-center">
                    <a href="{{ path('depute_votes', {dptSlug: depute.dpt_slug, slug: depute.slug}) }}" class="stretched-link no-decoration">VOIR TOUS</a>
                  </div>
                </div>
              </div>
              <div class="carousel-buttons d-flex justify-content-center mt-3">
                <button type="button" class="btn prev mr-2 carousel--prev" aria-label="précédent">
                  <svg width="1em" height="1em" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M5.854 4.646a.5.5 0 0 1 0 .708L3.207 8l2.647 2.646a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 0 1 .708 0z"/><path fill-rule="evenodd" d="M2.5 8a.5.5 0 0 1 .5-.5h10.5a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/></svg>
                </button>
                <button type="button" class="btn next ml-2 carousel--next" aria-label="suivant">
                  <svg width="1em" height="1em" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.146 4.646a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L12.793 8l-2.647-2.646a.5.5 0 0 1 0-.708z"/><path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5H13a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 8z"/></svg>
                </button>
              </div>
            </div>
          </div>
        {% endif %}

        {% if bloc == 'election' and election %}
          {# La participation locale est masquée en contexte iframe, comme le
             legacy (« Taux de participation (hors iframe) ») : on la neutralise
             en passant participation à null au partial partagé avec la fiche. #}
          {{ include('depute/_election.html.twig', {depute: depute, election: election|merge({participation: null})}) }}
        {% endif %}

        {# Graphiques de comportement : mêmes jauges que la fiche, intitulés à la
           première personne sous ?first-person=true. Silencieux avant la 17e
           (statistiques nul). #}
        {% if bloc == 'comportement-politique' and statistiques %}
          <div class="bloc-statistiques mt-5">
            {% if sous_titres_visibles %}<h2 class="mb-3 title-center">{{ possessif }} comportement politique</h2>{% endif %}
            {{ include('iframe/_comportement.html.twig') }}
          </div>
        {% endif %}

      {% endfor %}

      <p class="datan-credit">
        <img src="{{ asset('assets/imgs/favicon/datan_favicon.svg') }}" alt="logo de Datan" class="datan-logo">
        Ce service est proposé par le site <a href="https://datan.fr" target="_blank" rel="noopener">datan.fr</a>
      </p>
    </div>
  </main>

  {# Modales des explications de vote citées dans le carrousel, hors de la grille
     — comme le legacy les rend en pied de fiche. Le texte est une saisie de
     député (`nl2br`, jamais `|raw`). #}
  {% for vote in carrousel_votes|filter(v => v.explication) %}
    {{ include('depute/_modale_explication.html.twig') }}
  {% endfor %}

  {# Même socle interactif que le reste du site (repli des cartes, infobulles,
     carrousel) — sans le pistage ni la bannière de consentement. Flickity
     précède main.min.js, qui initialise le carrousel des votes. #}
  <script src="{{ asset('assets/js/libraries/jquery/jquery-3.5.1.min.js') }}"></script>
  <script src="{{ asset('assets/js/libraries/popper/popper.min.js') }}"></script>
  <script src="{{ asset('assets/js/libraries/bootstrap/bootstrap.min.js') }}"></script>
  <script src="{{ asset('assets/js/libraries/flickity/flickity.pkgd.min.js') }}"></script>
  <script src="{{ asset('assets/js/main.min.js') }}"></script>
</body>
</html>
