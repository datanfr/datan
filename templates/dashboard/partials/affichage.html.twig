{% endmacro %}

{#
  Pastille de position, aux classes `badgePour` / `badgeContre` /
  `badgeAbstention` de la feuille de style du tableau de bord.

  `nonVotant` n'y a pas de classe : c'est voulu côté rédaction — un non-votant
  n'a pas pris position — mais une explication héritée de la production peut
  porter cette position, et la ligne doit rester lisible. On se rabat alors sur
  la pastille neutre de Bootstrap.
#}
{% macro position(position) %}
  {% set libelles = {'pour': 'Pour', 'contre': 'Contre', 'abstention': 'Abstention', 'nonVotant': 'Non votant'} %}
  {% set classes = {'pour': 'badgePour', 'contre': 'badgeContre', 'abstention': 'badgeAbstention'} %}
  <span class="badge {{ classes[position]|default('badge-secondary') }}" style="font-size: 16px">{{ libelles[position]|default('—') }}</span>
{% endmacro %}

{#
  Position en texte coloré, comme le tableau récapitulatif du legacy — pastille
  dans les listes, texte coloré ici, et la feuille de style couvre bien les
  trois positions exprimées. `nonVotant` n'a pas de classe : il ne peut pas
  arriver par le formulaire, seulement par une explication héritée.
#}
{% macro position_texte(position) %}
  {% set libelles = {'pour': 'Pour', 'contre': 'Contre', 'abstention': 'Abstention', 'nonVotant': 'Non votant'} %}
  {% set classes = {'pour': 'colorPour', 'contre': 'colorContre', 'abstention': 'colorAbstention'} %}
  <span class="{{ classes[position]|default('') }} font-weight-bold">{{ libelles[position]|default('—') }}</span>
{% endmacro %}

{# Aperçu d'un texte long, coupé au mot comme le `word_limiter()` du legacy. #}
{% macro resume(texte, mots = 30) %}
  {%- set decoupe = texte|default('')|split(' ') -%}
  {{- decoupe|slice(0, mots)|join(' ') -}}
  {{- decoupe|length > mots ? '…' : '' -}}
{% endmacro %}
