{% extends 'dashboard/base.html.twig' %}
{% import 'dashboard/partials/affichage.html.twig' as afficher %}

{% block title %}Tableau de bord{% endblock %}
{% block heading %}Bienvenue sur votre tableau de bord{% endblock %}

{% block fil_ariane %}{% endblock %}

{% block body %}
  <p class="mt-3">
    Ce tableau de bord vous donne accès à des fonctionnalités dédiées aux députés.
    Si vous avez des questions, n'hésitez pas à nous contacter : <i>info@datan.fr</i>
  </p>

  <div class="row mt-4">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header b-none">
          <h2 class="m-0 font-weight-bold h5">Vos explications de vote en brouillon</h2>
        </div>
        <div class="card-body">
          {% if brouillons %}
            <p>
              Vous avez une ou plusieurs explications de vote en brouillon.
              N'hésitez pas à les terminer pour les publier sur votre page Datan.
            </p>
            <div class="table-responsive mt-4">
              <table class="table">
                <thead class="thead-dark">
                  <tr>
                    <th scope="col">Scrutin</th>
                    <th scope="col" class="text-center">Position</th>
                    <th scope="col"></th>
                  </tr>
                </thead>
                <tbody>
                  {% for brouillon in brouillons %}
                    <tr>
                      <td class="font-weight-bold">{{ brouillon.titre_datan }}</td>
                      <td class="text-center">{{ afficher.position(brouillon.position_depute) }}</td>
                      <td>
                        <a class="btn btn-primary d-flex align-items-center justify-content-center font-weight-bold"
                           href="{{ path('dashboard_explication_modifier', {legislature: brouillon.legislature, numero: brouillon.vote_numero}) }}">
                          {{ afficher.crayon() }}<span class="ml-3">Modifier</span>
                        </a>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <p class="mb-0">Vous n'avez pas d'explication de vote en brouillon. N'hésitez pas à en créer une nouvelle.</p>
          {% endif %}
        </div>
        <div class="card-footer d-flex justify-content-center align-items-center">
          <a class="btn btn-primary font-weight-bold" style="font-size: 1.1rem"
             href="{{ path('dashboard_explications') }}" role="button">Voir toutes vos explications de vote</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
