{% extends 'base.html.twig' %}
{% import 'search/_icones.html.twig' as ico %}

{% block title %}« {{ query }} » - Cherchez un député, une ville, un groupe | Datan{% endblock %}

{% block meta_description %}Cherchez votre député, votre ville, un groupe politique, ou un scrutin de l'Assemblée nationale sur Datan.{% endblock %}

{# Page de recherche : indexée par personne, comme le legacy (seoNoFollow). #}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
<div class="container-fluid pg-search bg-info py-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <h1 class="text-center mb-3">Recherchez sur Datan</h1>
        <form id="searchForm" method="GET" autocomplete="off">
          <div class="row">
            <div class="col-lg-10">
              <input class="form-control" id="searchInput" type="text" value="{{ query }}">
            </div>
            <div class="col-lg-2 d-flex justify-content-center mt-3 mt-lg-0">
              <button type="submit" class="btn btn-primary d-flex justify-content-center align-items-center">
                {{ ico.icone('search') }}<span class="ml-2">Rechercher</span>
              </button>
            </div>
          </div>
        </form>
        <p class="text-center mt-3 mb-0 text-white font-italic">Recherchez un député, un groupe politique, une ville, un vote</p>
      </div>
    </div>
  </div>
</div>
<div class="container pg-search py-5">
  <div class="row">
    <div class="col-lg-10 offset-lg-1">
      <h2>Résultats : « {{ query }} »</h2>
      <p class="results mb-0">{{ count }} résultat{{ count > 1 ? 's' : '' }}</p>
    </div>
    <div class="col-lg-10 offset-lg-1 mt-4">
      {% for key, famille in familles %}
        {% if famille.resultats %}
          {% set total = famille.resultats|length %}
          {% set entries = total > max_entries ? max_entries : total %}
          <div class="mb-5">
            <h3>
              {{ ico.icone(famille.icone) }}
              {{ famille.nom }}
              <span>- {{ total }} résultat{{ total > 1 ? 's' : '' }}</span>
            </h3>
            <div class="card card_results mt-3">
              <div class="card-body p-0" id="results_{{ key }}">
                {% for r in famille.resultats|slice(0, 10) %}
                  {# title/description viennent de l'open data et de l'éditorial,
                     surlignés par le contrôleur : rendu brut comme le legacy. #}
                  <a class="no-decoration" href="/{{ r.url }}">
                    <div class="text">
                      <div class="title">{{ r.title|raw }}</div>
                      <div class="description">{{ r.description|raw }}</div>
                    </div>
                    <div class="icon"></div>
                  </a>
                {% endfor %}
              </div>
              {% if entries != total %}
                <div class="card-footer d-flex flex-column align-items-center bg-info py-3">
                  <p class="text-center text-white mb-0">Vous avez vu <span id="number_{{ key }}">{{ entries }}</span> résultats sur {{ total }}</p>
                  <div class="d-flex justify-content-center">
                    <button class="btn btn-light mt-3" onclick="showMore('{{ key }}')" id="button_{{ key }}" type="button">Voir plus de résultats</button>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
  {# Le champ de la page renvoie vers /recherche/{terme} : l'URL relative encodée
     remplace le dernier segment de l'adresse courante, comme le legacy. #}
  document.getElementById('searchForm').addEventListener('submit', function (event) {
    event.preventDefault();
    var query = document.getElementById('searchInput').value.trim();
    if (query !== '') {
      window.location.href = encodeURIComponent(query);
    }
  });

  var max_entries = 10;
  var familles = {{ familles|json_encode|raw }};

  function showMore(type) {
    var container = document.getElementById('results_' + type);
    var number = document.getElementById('number_' + type);
    var elements = familles[type].resultats;
    var restants = elements.slice(max_entries);

    if (restants.length > 0) {
      for (var i = 0; i < Math.min(10, restants.length); i++) {
        var a = document.createElement('a');
        a.className = 'no-decoration';
        a.href = '/' + restants[i].url;

        var text = document.createElement('div');
        text.className = 'text';

        var title = document.createElement('div');
        title.className = 'title';
        title.innerHTML = restants[i].title;

        var description = document.createElement('div');
        description.className = 'description';
        description.innerHTML = restants[i].description;

        var icon = document.createElement('div');
        icon.className = 'icon';

        text.appendChild(title);
        text.appendChild(description);
        a.appendChild(text);
        a.appendChild(icon);
        container.appendChild(a);

        max_entries++;
      }

      number.innerText = max_entries;

      if (max_entries >= elements.length) {
        document.getElementById('button_' + type).style.display = 'none';
      }
    } else {
      document.getElementById('button_' + type).style.display = 'none';
    }
  }
</script>
{% endblock %}
