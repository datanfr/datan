{# Carte d'un vote décrypté pour le carrousel « Ses derniers votes » de la fiche.
   Reprise de `deputes/partials/card_vote.php` : la position du député en pastille
   colorée (la classe `.thumb.pour|contre|abstention` d'`main.css`), la date
   abrégée, le titre en lien vers le scrutin, la lecture, et — quand le député a
   publié une explication — un bouton qui ouvre la modale de son avis.

   Le lien passe par `lien_vote()` : un vote du Congrès porte un numéro négatif
   en base, que `path('vote_individual')` refuserait (cf. CLAUDE.md). #}
<div class="card card-vote">
  <div class="thumb d-flex align-items-center {{ vote.position }}">
    <div class="d-flex align-items-center">
      <span>{{ vote.position|upper }}</span>
    </div>
  </div>
  <div class="card-header d-flex flex-row justify-content-between">
    <span class="date">{{ vote.date_scrutin|date_abregee }}</span>
  </div>
  <div class="card-body d-flex flex-column justify-content-center">
    <span class="title">
      <a href="{{ lien_vote(vote.legislature, vote.vote_numero) }}" class="stretched-link underline no-decoration">{{ vote.title }}</a>
    </span>
    {% if vote.lecture_name %}
      <span class="reading mt-2">{{ vote.lecture_name }}</span>
    {% endif %}
  </div>
  {% if vote.explication %}
    {# `z-index: 2` fait passer le bouton au-dessus du `stretched-link` du titre,
       comme le legacy, sinon le clic ouvrirait le scrutin au lieu de la modale. #}
    <button class="explication py-2 d-flex justify-content-center align-items-center"
            data-toggle="modal" data-target="#explication-l{{ vote.legislature }}-v{{ vote.vote_numero }}"
            style="z-index: 2">
      <div class="icon d-flex justify-content-center align-items-center">
        <svg width="1em" height="1em" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
      </div>
      <span class="ml-2">L'avis {{ depute.civilite == 'Mme' ? 'de la députée' : 'du député' }}</span>
    </button>
  {% endif %}
</div>
