{# Modale de l'explication de vote d'un député, ouverte depuis la carte du
   carrousel (`votes/modals/explain.php` du legacy, réduit à l'essentiel).
   Le texte est rendu avec `nl2br` et non `|raw` : l'espace député en fait une
   saisie, donc une injection possible sur page publique (cf. TODO §6). #}
<div class="modal fade" id="explication-l{{ vote.legislature }}-v{{ vote.vote_numero }}"
     tabindex="-1" role="dialog" aria-labelledby="titre-explication-l{{ vote.legislature }}-v{{ vote.vote_numero }}" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="titre-explication-l{{ vote.legislature }}-v{{ vote.vote_numero }}">
          L'avis de {{ depute.firstname }} {{ depute.lastname }}
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p class="font-italic mb-3">{{ vote.title }}</p>
        <p class="mb-0">{{ vote.explication|nl2br }}</p>
      </div>
    </div>
  </div>
</div>
