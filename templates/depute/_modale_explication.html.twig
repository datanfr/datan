{# Modale de l'explication de vote d'un député, ouverte depuis la carte du
   carrousel ou de la liste de ses votes : la vue commune du site, avec le
   portrait, la citation et le bouton « Fermer » que le portage avait retirés. #}
{{ include('partials/modale_explication.html.twig', {
  id: 'explication-l' ~ vote.legislature ~ '-v' ~ vote.vote_numero,
  titre: "L'avis de " ~ depute.firstname ~ ' ' ~ depute.lastname,
  vote_titre: vote.title,
  texte: vote.explication,
  mp_id: depute.mp_id,
  carree: depute.legislature_last|default(17) >= 17,
}) }}
