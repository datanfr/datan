{% extends 'base.html.twig' %}

{% block title %}Votes Assemblée Nationale - Résultat et Analyse | Datan{% endblock %}

{% block meta_description %}Retrouvez tous les votes de l'Assemblée nationale de la {{ legislature }}e législature décryptés par Datan. Détails des votes, résultats des groupes et des députés, statistiques de participation, de loyauté et de cohésion.{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/flickity.min.css') }}">
{% endblock %}

{# Flickity doit être présent avant main.min.js, qui initialise les carrousels. #}
{% block javascripts_head %}
  <script src="{{ asset('assets/js/libraries/flickity/flickity.pkgd.min.js') }}"></script>
{% endblock %}

{% block body %}
<div class="container-fluid pg-vote-all" id="container-always-fluid">
  <div class="row">
    <div class="container">
      <div class="row row-grid bloc-titre mb-5">
        <div class="col-md-7 my-5">
          <h1>Les votes décryptés par Datan</h1>
        </div>
        <div class="col-md-10 mb-lg-5 mb-4">
          <p>
            L'équipe de Datan décrypte pour vous les votes les plus intéressants de la législature.
            Il s'agit des votes qui ont fait l'objet d'attention médiatique, ou sur lesquels un ou plusieurs groupes parlementaires étaient fortement divisés.
          </p>
          <p>
            Tous ces votes décryptés font l'objet d'une reformulation et d'une contextualisation, afin de les rendre plus accessibles et plus compréhensibles.
          </p>
          <p>
            Si vous voulez avoir accès à <b>tous</b> les votes de l'Assemblée nationale, qu'ils soient décryptés par nos soins ou non, <a href="{{ path('votes_legislature', {legislature: legislature}) }}">cliquez ici</a>.
          </p>
        </div>
        <div class="col-12 carousel-container bloc-carousel-votes-flickity">
          <div class="carousel-cards">
            {% for vote in decryptages %}
              {{ include('vote/partials/carte.html.twig') }}
            {% endfor %}
            <div class="card card-vote see-all">
              <div class="card-body d-flex align-items-center justify-content-center">
                <a href="{{ path('votes_decryptes') }}" class="stretched-link no-decoration">VOIR TOUS</a>
              </div>
            </div>
          </div>
          {{ include('vote/partials/boutons_carrousel.html.twig') }}
        </div>
      </div>
    </div>
  </div>
  <!-- PAR CATÉGORIE -->
  <div class="row bloc-category" id="pattern_background">
    <div class="container py-5">
      <div class="row pb-5">
        <div class="col-12">
          <h2>Derniers votes décryptés par catégorie</h2>
        </div>
      </div>
      {% for categorie in categories %}
        <div class="row my-5">
          <div class="col-12 col-lg-3 d-flex justify-content-center align-items-center">
            <h3 class="mb-0 text-center">
              <a href="{{ path('votes_categorie', {slug: categorie.slug}) }}" class="underline no-decoration">{{ categorie.name }}</a>
            </h3>
          </div>
          <div class="col-lg-7 col-md-12">
            <div class="row">
              {% for vote in categorie.decryptages %}
                <div class="col-12 col-md-6 d-flex justify-content-center my-3 my-lg-0">
                  {{ include('vote/partials/carte.html.twig') }}
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="col-12 col-lg-2 d-flex justify-content-center align-items-center my-3 my-lg-0">
            <a class="btn see-all-votes py-1" href="{{ path('votes_categorie', {slug: categorie.slug}) }}">
              <span>VOIR TOUS</span>
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <!-- DERNIERS SCRUTINS -->
  <div class="row">
    <div class="container py-5">
      <div class="row pb-2">
        <div class="col-12">
          {# Le site d'origine titre « non-decryptés », mais sa requête ne filtre
             rien : ce bloc liste les derniers scrutins tenus, décryptés ou non.
             On garde la requête, qui rend le même carrousel, et on corrige
             l'intitulé. #}
          <h2>Les derniers votes de l'Assemblée nationale</h2>
        </div>
      </div>
      <div class="row mt-5">
        <div class="col-12 carousel-container bloc-carousel-votes-flickity">
          <div class="carousel-cards">
            {% for scrutin in scrutins %}
              <div class="card card-vote">
                <div class="thumb d-flex align-items-center {{ scrutin.sort_code }}">
                  <div class="d-flex align-items-center">
                    <span>{{ scrutin.sort_code|upper }}</span>
                  </div>
                </div>
                <div class="card-header d-flex flex-row justify-content-between">
                  <span class="date">{{ scrutin.date_scrutin|date_abregee }}</span>
                </div>
                <div class="card-body d-flex align-items-center">
                  <span class="title">
                    <a href="{{ lien_vote(scrutin.legislature, scrutin.numero) }}" class="stretched-link no-decoration">{{ scrutin.titre }}</a>
                  </span>
                </div>
              </div>
            {% endfor %}
          </div>
          {{ include('vote/partials/boutons_carrousel.html.twig') }}
        </div>
      </div>
    </div>
  </div>
  <!-- ARCHIVES -->
  {% if archives %}
    <div class="row" id="pattern_background">
      <div class="container py-5">
        <div class="row pb-5">
          <div class="col-12">
            <h2>Archives</h2>
          </div>
        </div>
        <div class="row pb-4">
          <div class="col-12 text-center">
            <span>
              Pour voir tous les votes,
              <a href="{{ path('votes_legislature', {legislature: legislature}) }}">cliquez ici</a>.
            </span>
          </div>
        </div>
        <div class="row">
          <div class="col-12 d-flex flex-row flex-wrap">
            {% for an, mois_liste in archives %}
              <div class="flex-fill text-center px-1 py-2">
                <div class="year d-flex flex-column align-items-center">
                  <div class="my-2 d-flex justify-content-center align-items-center">
                    <div class="d-flex justify-content-center align-items-center">
                      <span><a href="{{ path('votes_annee', {legislature: legislature, annee: an}) }}" class="no-decoration underline-blue">{{ an }}</a></span>
                    </div>
                  </div>
                </div>
                <div class="months mt-4 d-flex flex-column align-items-center">
                  {% for m in mois_liste %}
                    <div class="my-2 d-flex justify-content-center align-items-center">
                      <div class="d-flex justify-content-center align-items-center">
                        <a href="{{ path('votes_mois', {legislature: legislature, annee: an, mois: '%02d'|format(m.mois)}) }}" class="no-decoration underline-blue">{{ m.libelle|capitalize }}</a>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>
{% endblock %}
