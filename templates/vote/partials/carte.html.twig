{# Carte d'un vote décrypté, portée de application/views/votes/partials/card_vote.php.

   Le numéro d'un vote du Congrès est stocké négatif : c'est `lien_vote()` qui
   choisit la route, jamais `path('vote_individual')`, dont la contrainte
   numérique lèverait une erreur. #}
<div class="card card-vote">
  <div class="thumb d-flex align-items-center {{ vote.sort_code }}">
    <div class="d-flex align-items-center">
      <span>{{ vote.sort_code|upper }}</span>
    </div>
  </div>
  <div class="card-header d-flex flex-row justify-content-between">
    <span class="date">{{ vote.date_scrutin|date_abregee }}</span>
  </div>
  <div class="card-body d-flex flex-column justify-content-center">
    <span class="title">
      <a href="{{ lien_vote(vote.legislature, vote.vote_numero) }}" class="stretched-link no-decoration">{{ vote.title }}</a>
    </span>
    {% if vote.lecture_name %}
      <span class="reading mt-2">{{ vote.lecture_name }}</span>
    {% endif %}
  </div>
  {% if vote.categorie_name is defined and vote.categorie_name %}
    <div class="card-footer">
      <span class="field badge badge-primary py-1 px-2">{{ vote.categorie_name }}</span>
    </div>
  {% endif %}
</div>
