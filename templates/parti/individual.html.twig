{% extends 'base.html.twig' %}

{% block preloads %}{{ include('partials/preload_couverture.html.twig') }}{% endblock %}

{# « Non rattaché(s) » et « Non déclaré(s) » sont des organes PARPOL de service,
   pas des partis : toute la page leur tient un autre discours. #}
{% set special = parti.libelle_abrev in ['NR', 'ND'] %}
{% set non_rattaches = parti.libelle_abrev == 'NR' %}
{% set actif = parti.date_fin is null %}

{% set titre = special
  ? (non_rattaches ? 'Députés non rattachés à un parti politique' : 'Députés sans rattachement à un parti politique')
  : parti.libelle ~ ' (' ~ parti.libelle_abrev ~ ')' %}

{% block title %}
  {%- if special %}{{ titre }} | Datan
  {%- else %}{{ parti.libelle }} - Parti politique | Datan
  {%- endif %}
{% endblock %}

{% block meta_description %}
  {% if non_rattaches %}
    Découvrez les députés de l'Assemblée nationale qui déclarent ne pas être rattachés financièrement à un parti politique.
  {% elseif special %}
    Découvrez les députés de l'Assemblée nationale qui ne déclarent aucun rattachement financier à un parti politique.
  {% else %}
    Découvrez les députés de l'Assemblée nationale rattachés au parti politique {{ parti.libelle }} ({{ parti.libelle_abrev }}).
  {% endif %}
{% endblock %}

{% block schema %}
  <script type="application/ld+json">
  {{ {
    '@context': 'http://schema.org',
    '@type': 'Organization',
    'name': parti.libelle ~ ' (' ~ parti.libelle_abrev ~ ')',
    'url': url('parti_individual', {abrev: parti.libelle_abrev|lower}),
    'description': parti.libelle ~ ' (' ~ parti.libelle_abrev ~ ') est un ' ~ (actif ? '' : 'ancien ') ~ 'parti politique français.',
    'numberOfEmployees': parti.effectif,
    'member': deputes|map(depute => {
      '@type': 'Person',
      'name': depute.firstname ~ ' ' ~ depute.lastname,
      'familyName': depute.lastname,
      'givenName': depute.firstname,
      'jobTitle': 'Député français et membre apparenté au parti ' ~ parti.libelle,
    }),
  }|json_encode|raw }}
  </script>
{% endblock %}

{% block body %}
<div class="container-fluid bloc-img-deputes bloc-img d-flex async_background" id="container-always-fluid">
  <div class="container d-flex flex-column justify-content-center py-2 pg-parties-individual">
    <div class="row">
      <div class="col-sm-9 col-lg-10 title-text">
        <h1 class="mb-0">{{ titre }}</h1>
        <span class="subtitle">
          {% if special %}
            {{ parti.effectif }} député{{ parti.effectif > 1 ? 's' }}
          {% else %}
            {{ actif ? 'Parti politique' : 'Ancien parti politique' }}
            -
            {% if parti.effectif == 0 %}Aucun député rattaché
            {%- else %}{{ parti.effectif }} député{{ parti.effectif > 1 ? 's rattachés' : ' rattaché' }}
            {%- endif %}
          {% endif %}
        </span>
      </div>
      {% if parti.logo %}
        <div class="col-sm-3 col-lg-2 d-flex justify-content-center">
          <div class="img-party">
            <img src="{{ asset('assets/imgs/partis/' ~ parti.libelle_abrev|lower ~ '.png') }}" width="150" height="150" alt="{{ parti.libelle }}">
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
<div class="liseret-groupe" style="background-color: {{ parti.couleur }}"></div>
<div class="container pb-4 pg-parties-individual">
  <div class="row {{ parti.logo ? 'first-row' : 'mt-5' }}">
    <div class="col-lg-10">
      {% if special %}
        {% if non_rattaches %}
          <p>Découvrez sur cette page les députés qui déclarent ne pas être rattachés financièrement à un parti politique.</p>
        {% else %}
          <p>Découvrez sur cette page les députés qui ne déclarent pas de rattachement financier à un parti politique.</p>
        {% endif %}
        <p>Cela ne veut pas dire que ces députés ne sont pas membres d'un parti politique.</p>
      {% else %}
        <p>
          <b>{{ parti.libelle }} est un {{ actif ? '' : 'ancien ' }}parti politique français.</b>
        </p>
        {# Le site de référence referme son `if` trop tôt (`else:` vide suivi de
           `endif;`) : sur un parti sans député rattaché il empile les deux
           paragraphes, et le second sort à trou — « Actuellement, député est
           rattaché », l'effectif nul ne s'imprimant pas. Le voir sur
           /partis-politiques/modem ; ici les deux cas s'excluent. #}
        {% if parti.effectif == 0 %}
          <p>
            Actuellement, aucun député n'est rattaché financièrement au parti {{ parti.libelle }}. Les députés rattachés ne sont pas des députés membres du parti, même s'ils ont tendance à en être proches d'un point de vue idéologique.
          </p>
        {% else %}
          <p>
            Actuellement, {{ parti.effectif }} député{{ parti.effectif > 1 ? 's sont rattachés' : ' est rattaché' }} financièrement au parti {{ parti.libelle }}. Cela ne veut pas dire que ces députés soient membres du parti, même s'ils ont tendance à en être proches d'un point de vue idéologique.
          </p>
        {% endif %}
      {% endif %}
      <p>
        Le rattachement permet surtout aux parlementaires d'aider financièrement une formation politique. En effet, le montant des subventions publiques que reçoivent chaque année les partis politiques dépend du nombre de députés et sénateurs rattachés financièrement.
      </p>
      <p>
        Attention, <b>les partis politiques sont différents des groupes parlementaires</b>. Les groupes rassemblent, à l'Assemblée nationale, des députés selon leur affinité politique, et proposent aux parlementaires des ressources importantes, comme du temps de parole. Un groupe parlementaire peut donc réunir des députés venant de partis différents.
      </p>
      <p>
        Pour découvrir les groupes parlementaires à l'Assemblée nationale, <a href="{{ path('groupes_index') }}">cliquez ici</a>.
      </p>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      {% if deputes is empty %}
        <p class="my-3"><b>Aucun député n'est actuellement rattaché au parti politique <u>{{ parti.libelle }}</u></b></p>
      {% elseif non_rattaches %}
        <h2 class="my-5">Découvrez les députés non rattachés à un parti politique</h2>
      {% elseif special %}
        <h2 class="my-5">Découvrez les députés qui ne déclarent pas de rattachement à un parti</h2>
      {% else %}
        <h2 class="my-5">Découvrez les députés rattachés au parti {{ parti.libelle }}</h2>
      {% endif %}
    </div>
  </div>
  {% if deputes is not empty %}
    <div class="row">
      <div class="col-12 d-flex flex-wrap justify-content-around">
        {% for depute in deputes %}
          {{ include('depute/partials/card.html.twig') }}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>
<div class="container-fluid pg-party-individual bloc-others-container mt-5">
  <div class="container bloc-others">
    {{ include('parti/partials/liens.html.twig', {titre: 'Partis politiques avec au moins un député rattaché financièrement', partis: rattaches}) }}
    {{ include('parti/partials/liens.html.twig', {titre: 'Partis politiques sans député rattaché financièrement', partis: sans_depute}) }}
    {{ include('parti/partials/liens.html.twig', {titre: 'Anciens partis politiques', partis: anciens}) }}
  </div>
</div>
{% endblock %}
