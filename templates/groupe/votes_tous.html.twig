{% extends 'base.html.twig' %}

{% block preloads %}{{ include('partials/preload_couverture.html.twig') }}{% endblock %}

{% set nom_groupe = groupe.libelle|name_group %}
{% set non_inscrits = groupe.libelle_abrev == 'NI' %}

{% block title %}{{ non_inscrits ? 'Députés non inscrits' : 'Groupe ' ~ nom_groupe }} - Tous les votes | Datan{% endblock %}

{% block meta_description %}{% if non_inscrits %}Retrouvez tous les votes des députés non inscrits (NI) : positions politiques, cohésion interne, participation.{% else %}Retrouvez tous les votes du groupe {{ nom_groupe }} ({{ groupe.libelle_abrev }}) : ses positions politiques, sa cohésion interne, sa participation.{% endif %}{% endblock %}

{% block body %}
{# En-tête de `groupes/votes.php`, que le portage avait réécrit : bandeau nu —
   cette sous-page n'a pas le bandeau mobile des autres, son « Retour profil »
   reste visible à toutes les largeurs —, titre « … à l'Assemblée », les trois
   paragraphes du site et le sous-titre au nombre de scrutins.

   Seul écart : pour les non-inscrits, le site écrit « du groupe Députés non
   inscrits » ; l'accord est corrigé, comme ailleurs sur leurs pages. #}
<div class="container-fluid bloc-img-deputes async_background" id="container-always-fluid" style="height: 13em"></div>
{% if groupe.couleur %}
  <div class="liseret-groupe" style="background-color: {{ groupe.couleur }}"></div>
{% endif %}

<div class="container pg-groupe-votes pb-5">
  <div class="row">
    <div class="col-12 col-md-8 col-lg-4 offset-md-2 offset-lg-0 px-lg-4">
      {{ include('groupe/partials/carte_profil.html.twig') }}
    </div>
    <div class="col-md-10 col-lg-8 offset-md-1 offset-lg-0 pl-lg-5 bloc-votes-datan">
      <div class="row mt-4">
        <div class="col-12 btn-back text-center text-lg-left">
          <a class="btn btn-outline-primary mx-2" href="{{ path('groupe_individual', {legislature: groupe.legislature, abrev: groupe.libelle_abrev|adresse_groupe(groupe.id ?? null)}) }}">{{ include('groupe/partials/fleche_retour.html.twig') }}Retour profil</a>
        </div>
      </div>
      <div class="row mt-4">
        <div class="col-12">
          <h1>Tous les votes {{ non_inscrits ? 'des députés non inscrits' : 'du groupe ' ~ nom_groupe }} à l'Assemblée</h1>
        </div>
      </div>
      <div class="row mt-4">
        <div class="col-lg-10">
          <p>
            Cette page présente les positions {{ non_inscrits ? 'des députés non inscrits' : 'du groupe ' ~ nom_groupe }} ({{ groupe.libelle_abrev }}) sur tous les votes de l'Assemblée nationale.
          </p>
          <p>
            Les données de ces votes sont automatiquement récupérées sur le site de l'Assemblée, et ne font donc pas l'objet d'une analyse et d'une recontextualisation. La signification de ces votes peut donc être complexe à comprendre au premier abord.
          </p>
          <p>
            C'est pourquoi l'équipe de Datan contextualise et reformule certains scrutins. Pour découvrir les positions {% if non_inscrits %}des <b>députés non inscrits</b>{% else %}du groupe <b>{{ nom_groupe }}</b>{% endif %} sur ces votes, <a href="{{ path('groupe_votes', {legislature: groupe.legislature, abrev: groupe.libelle_abrev|adresse_groupe(groupe.id ?? null)}) }}">cliquez ici</a>.
          </p>
        </div>
      </div>
      <div class="row mt-4">
        <div class="col-12">
          <h2>Les positions {{ non_inscrits ? 'des députés non inscrits' : 'du groupe ' ~ groupe.libelle_abrev }} sur <span class="text-primary">{{ votes|length }} scrutins</span></h2>
        </div>
      </div>
      <div class="row mt-4">
      {# L'identifiant est celui qu'attend data-table-datan.js, qui se branche
         par sélecteur : c'est lui qui pagine, trie et rend le tableau utilisable
         malgré ses milliers de lignes. #}
      <table class="table" id="table-deputes-groupes-votes-all">
        <caption class="sr-only">Tous les votes du groupe {{ groupe.libelle_abrev }}</caption>
        <thead>
          <tr>
            <th scope="col" class="all">N°</th>
            <th scope="col" class="min-tablet">Date</th>
            <th scope="col" class="all">Titre</th>
            <th scope="col" class="text-center all">Résultat</th>
            <th scope="col" class="text-center all">
              Cohésion
              {# La bulle d'aide du site ; « Le mesure » y est corrigé. #}
              {{ include('groupe/partials/aide.html.twig', {titre: 'Taux de cohésion', libelle: 'la cohésion', contenu: "Le taux de cohésion représente <b>l'unité d'un groupe politique</b> lorsqu'il vote. Il peut prendre des mesures allant de 0 à 1. Un taux proche de 1 signifie que le groupe est très uni.<br><br>Attention, dans beaucoup de parlements, y compris l'Assemblée nationale, les députés suivent dans la plupart des cas la ligne officielle du groupe, expliquant des taux de cohésion très élevés. La mesure proposée ici est intéressante quand elle est comparée avec les mesures de cohésion des autres groupes.<br><br>Pour plus d'information, <a href='" ~ path('page_statistiques') ~ "#cohesion' title='Lien'>cliquez ici.</a>"}) }}
            </th>
          </tr>
        </thead>
        <tbody>
          {% for vote in votes %}
            {% set url = lien_vote(vote.legislature, vote.numero) %}
            <tr data-href="{{ url }}">
              {# Seules les premières lignes portent un lien : la page en compte
                 plusieurs milliers, et l'application d'origine évite d'y semer
                 autant d'ancres. Les autres restent cliquables par la ligne. #}
              {% set numero = vote.numero|congress_numero %}
              <td>{% if loop.index <= 30 %}<a class="no-decoration" href="{{ url }}">{{ numero }}</a>{% else %}{{ numero }}{% endif %}</td>
              <td>{{ vote.date_scrutin }}</td>
              <td>
                {% if vote.decryptage_title %}
                  <span class="vote-datan-bold">{{ vote.decryptage_title }}</span><br>
                {% endif %}
                <span class="{{ vote.decryptage_title ? 'vote-datan-italic' : '' }}">{{ vote.titre }}</span>
              </td>
              <td class="sort text-center sort-{{ vote.position }}">{{ vote.position == 'nv' ? 'ABSENT' : vote.position|upper }}</td>
              <td class="sort text-center">{{ vote.cohesion ?? '—' }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('assets/js/libraries/moment/moment.min.js') }}"></script>
  {{ include('partials/scripts_datatable.html.twig') }}
  <script src="{{ asset('assets/js/libraries/datetime/datetime-moment.js') }}"></script>
  <script>
    // Toute la ligne est cliquable, faute d'ancre au-delà des trente premières.
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('tr[data-href]').forEach((ligne) => {
        ligne.addEventListener('click', () => { window.location.href = ligne.dataset.href; });
      });
    });
  </script>
{% endblock %}
