{# Carte d'un groupe en liste, portée de application/views/groupes/partials/card_home.php. #}
<div class="card card-groupe">
  {% if groupe.couleur %}
    <div class="liseret" style="background-color: {{ groupe.couleur }}"></div>
  {% endif %}
  <div class="card-avatar">
    <picture>
      <source srcset="{{ asset('assets/imgs/groupes/' ~ groupe.legislature ~ '/webp/' ~ groupe.libelle_abrev ~ '.webp') }}" type="image/webp">
      <source srcset="{{ asset('assets/imgs/groupes/' ~ groupe.legislature ~ '/' ~ groupe.libelle_abrev ~ '.png') }}" type="image/png">
      <img src="{{ asset('assets/imgs/groupes/' ~ groupe.legislature ~ '/' ~ groupe.libelle_abrev ~ '.png') }}" width="150" height="150" alt="{{ groupe.libelle|name_group }}">
    </picture>
  </div>
  <div class="card-body d-flex flex-column justify-content-center align-items-center">
    <h3 class="d-block card-title">
      {# Quelques sigles anciens (UDI_I) sortent du format accepté par la route
         de la page de groupe : leur fiche n'est pas atteignable, on n'y renvoie pas. #}
      {% if groupe.libelle_abrev|lower matches '/^[a-z0-9\\-&]+$/' %}
        <a href="{{ path('groupe_individual', {legislature: groupe.legislature, abrev: groupe.libelle_abrev|lower}) }}" class="stretched-link no-decoration">{{ groupe.libelle|name_group }}</a>
      {% else %}
        {{ groupe.libelle|name_group }}
      {% endif %}
    </h3>
    <span class="d-block libelle">{{ groupe.libelle_abrev }}</span>
    {# `cat` est la mention que porte la carte dans l'historique d'un groupe :
       la législature de cette incarnation. Elle remplace alors le pied
       d'effectif par le bouton de renvoi, comme dans `card_home.php`. #}
    {% if cat is defined and cat %}
      <span class="d-block mt-2">{{ cat }}<sup>ème</sup> législature</span>
    {% endif %}
  </div>
  {% if cat is defined and cat %}
    <div class="mb-3">
      <a class="btn btn-cat btn-primary stretched-link" href="{{ path('groupe_individual', {legislature: groupe.legislature, abrev: groupe.libelle_abrev|lower}) }}" role="button">Découvrez son activité</a>
    </div>
  {% elseif actifs %}
    <div class="card-footer d-flex justify-content-center align-items-center">
      <span>{{ groupe.effectif }} membres</span>
    </div>
  {% endif %}
</div>
