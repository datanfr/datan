{# Pied de la fiche d'un groupe (`groupes/partials/mps_footer.php`) : présidence,
   membres, apparentés et groupes de la législature, en liens nus.

   Les listes de députés y sont tronquées à vingt entrées, comme dans
   `Groupes::get_data()` — la page en compterait sinon jusqu'à 122, et ce pied
   est un maillage de liens, pas l'annuaire du groupe. Le lien qui suit mène à
   la page des membres, qui les porte tous. #}
{% set non_inscrits = groupe.libelle_abrev == 'NI' %}
{% set lien_membres = path('groupe_membres', {legislature: groupe.legislature, abrev: groupe.libelle_abrev|lower}) %}
<div class="container-fluid bloc-others-container mt-5">
  <div class="container bloc-others">
    {% if not non_inscrits and president %}
      <div class="row">
        <div class="col-12">
          <h2>Président{{ president.civilite == 'Mme' ? 'e' : '' }} du groupe {{ groupe.libelle|name_group }}</h2>
          <div class="row mt-3">
            <div class="col-6 col-md-3 py-2">
              <a class="membre no-decoration underline" href="{{ path('depute_individual', {dptSlug: president.dpt_slug, slug: president.slug}) }}">{{ president.firstname }} {{ president.lastname }}</a>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
    <div class="row">
      <div class="col-12">
        <h2>Tous les députés membres du groupe {{ groupe.libelle|name_group }}</h2>
        <div class="row mt-3">
          {% for membre in membres|slice(0, 20) %}
            <div class="col-6 col-md-3 py-2">
              <a class="membre no-decoration underline" href="{{ path('depute_individual', {dptSlug: membre.dpt_slug, slug: membre.slug}) }}">{{ membre.firstname }} {{ membre.lastname }}</a>
            </div>
          {% endfor %}
        </div>
        <div class="mt-3">
          <a href="{{ lien_membres }}">Voir tous les députés membres du groupe {{ groupe.libelle_abrev }}</a>
        </div>
      </div>
    </div>
    {% if apparentes %}
      <div class="row">
        <div class="col-12">
          <h2>Tous les députés apparentés du groupe {{ groupe.libelle|name_group }}</h2>
          <div class="row mt-3">
            {% for membre in apparentes|slice(0, 20) %}
              <div class="col-6 col-md-3 py-2">
                <a class="membre no-decoration underline" href="{{ path('depute_individual', {dptSlug: membre.dpt_slug, slug: membre.slug}) }}">{{ membre.firstname }} {{ membre.lastname }}</a>
              </div>
            {% endfor %}
          </div>
          <div class="mt-3">
            <a href="{{ lien_membres }}">Voir tous les députés apparentés au groupe {{ groupe.libelle_abrev }}</a>
          </div>
        </div>
      </div>
    {% endif %}
    <div class="row">
      <div class="col-12">
        {% if groupe.legislature == legislature_courante %}
          <h2>Tous les groupes parlementaires en activité de la {{ groupe.legislature }}<sup>ème</sup> législature</h2>
        {% else %}
          <h2>Les groupes parlementaires de la {{ groupe.legislature }}<sup>ème</sup> législature</h2>
        {% endif %}
        <div class="row mt-3">
          {% for g in groupes_legislature %}
            <div class="col-6 col-md-4 py-2">
              <a class="membre no-decoration underline" href="{{ path('groupe_individual', {legislature: g.legislature, abrev: g.libelle_abrev|lower}) }}">{{ g.libelle }} ({{ g.libelle_abrev }})</a>
            </div>
          {% endfor %}
        </div>
        <div class="mt-3">
          <a href="{{ groupe.legislature == legislature_courante ? path('groupes_index') : path('groupes_legislature', {legislature: groupe.legislature}) }}">Voir tous les groupes parlementaires de la {{ groupe.legislature }}<sup>ème</sup> législature</a>
        </div>
      </div>
    </div>
  </div>
</div>
