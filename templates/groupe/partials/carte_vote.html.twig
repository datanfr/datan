{# Carte d'un vote vue par un groupe, portée de
   application/views/groupes/partials/card_vote.php.

   Le bandeau ne porte pas le résultat du scrutin mais la position du groupe.
   `vote_groupe` a son propre vocabulaire : « nv » y désigne un groupe qui n'a
   pris part au vote, affiché « ABSENT ». #}
<div class="card card-vote">
  {% if vote.position == 'nv' %}
    <div class="thumb absent d-flex align-items-center">
      <div class="d-flex align-items-center">
        <span>ABSENT</span>
      </div>
    </div>
  {% else %}
    <div class="thumb d-flex align-items-center {{ vote.position }}">
      <div class="d-flex align-items-center">
        <span>{{ vote.position|upper }}</span>
      </div>
    </div>
  {% endif %}
  <div class="card-header d-flex flex-row justify-content-between">
    <span class="date">{{ vote.date_scrutin|date_abregee }}</span>
  </div>
  <div class="card-body d-flex flex-column justify-content-center">
    <span class="title">
      <a href="{{ lien_vote(vote.legislature, vote.vote_numero) }}" class="stretched-link no-decoration">{{ vote.title }}</a>
    </span>
    {% if vote.lecture_name %}
      <span class="reading mt-2">{{ vote.lecture_name }}</span>
    {% endif %}
  </div>
  {% if vote.categorie_name %}
    <div class="card-footer">
      <span class="field badge badge-primary py-1 px-2">{{ vote.categorie_name }}</span>
    </div>
  {% endif %}
</div>
