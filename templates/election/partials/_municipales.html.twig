{# Bloc « Résultats aux municipales 2026 » de la page de résultats d'une commune
   (`elections/results_city.php:13-441`), balisage repris tel quel.

   Variables : `m` (ResultatsMunicipales::pourCommune), `ville`, `nom_a`.

   Les nombres s'écrivent avec une espace insécable pour séparateur de
   milliers, comme le `formatNumber()` du site (« 555&nbsp;399 ») : un nombre
   ne se coupe pas en fin de ligne. #}
{% set nbsp = ' ' %}
<h2>Résultats aux municipales 2026 à {{ ville.nom }}</h2>

{% if m.en_attente %}
  <div class="alert alert-primary mt-4">
    Les résultats seront disponibles dès que possible pour la ville de {{ ville.nom }} à partir de 20h.
  </div>
{% endif %}

{% set s = m.synthese %}
{% if s.resultats is not empty %}
  {% set tete = s.resultats|first %}
  {% if s.cle == 't1' and s.pourvu %}
    <div class="card border-primary my-4">
      <div class="card-body py-3">
        La liste dirigée par <b>{{ tete.nom_complet }}</b> a remporté les élections municipales 2026 {{ nom_a }} avec <u>{{ tete.score|number_format(2, ',', ' ') }}%</u> des voix.
      </div>
    </div>
  {% elseif s.cle == 't2' and s.pct_saisis is not null and s.pct_saisis < 100 %}
    <div class="card border-primary mt-4">
      <div class="card-body py-3">
        Dépouillement en cours ({{ s.pct_saisis|number_format(0, ',', ' ') }}%).
      </div>
    </div>
  {% elseif s.cle == 't1' %}
    {# Le site nomme ici les têtes des listes déposées pour le second tour ;
       ces listes ne sont pas importées, la phrase s'arrête donc à l'annonce
       — ce que fait aussi le site quand il n'en connaît aucune. #}
    <div class="card border-primary my-4">
      <div class="card-body py-3">
        Un second tour sera organisé à {{ ville.nom }} le 22 mars.
      </div>
    </div>
  {% else %}
    <div class="card border-primary mt-4">
      <div class="card-body py-3">
        Au second tour, la liste dirigée par <b>{{ tete.nom_complet }}</b> est arrivée en tête à {{ ville.nom }} avec <u>{{ tete.score|number_format(2, ',', ' ') }}%</u> des voix.
      </div>
    </div>
  {% endif %}
{% endif %}

{% if m.situations is not empty %}
  <div class="card border py-1 mt-4">
    <div class="card-body">
      <div class="h5 text-info mb-3 font-weight-bold">La situation des listes entre les deux tours</div>
      <table class="table table-sm table-hover table-striped mb-0">
        <thead class="thead-light">
          <tr>
            <th>Liste</th>
            <th class="text-center">Score 1<sup>er</sup> tour</th>
            <th class="text-center">Situation</th>
          </tr>
        </thead>
        <tbody>
          {% for sit in m.situations %}
            <tr>
              <td class="font-weight-bold">
                {% if sit.enfant %}
                  <div class="d-flex flex-row">
                    <div class="ml-4">↖️</div>
                    <div class="ml-2">
                      <div>{{ sit.nom_complet }}</div>
                      <div><small class="text-muted">{{ sit.nuance }}</small></div>
                    </div>
                  </div>
                {% else %}
                  <div class="">{{ sit.nom_complet }}</div>
                  <div class=""><small class="text-muted">{{ sit.nuance }}</small></div>
                {% endif %}
              </td>
              <td class="text-center">{{ sit.score|number_format(1, ',', ' ') }}%</td>
              <td class="text-center">
                {% if sit.situation == 'maintien' %}
                  <span class="badge badge-success">Maintien</span>
                {% elseif sit.situation == 'fusion' %}
                  <span class="badge badge-warning">Fusion</span>
                {% else %}
                  <span class="badge badge-secondary">Désistement</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endif %}

{% if m.onglets %}
  <div class="previous-election-round-switch mt-4" data-municipales-switch="true">
    {% for tour in m.tours %}
      <button
        type="button"
        class="previous-election-round-btn municipales-round-btn {{ tour.cle == m.tour_par_defaut ? 'active' }}"
        data-round="{{ tour.cle }}"
        aria-pressed="{{ tour.cle == m.tour_par_defaut ? 'true' : 'false' }}">
        {{ tour.titre }}
      </button>
    {% endfor %}
  </div>
{% endif %}

{% for tour in m.tours %}
  <div
    class="municipales-round-content"
    data-round="{{ tour.cle }}"
    {{ tour.cle != m.tour_par_defaut ? 'style="display:none"'|raw }}>
    <div class="card border mt-3">
      <div class="card-body py-3">
        <div class="h4 font-weight-bold mt-3 mb-3 title">{{ tour.mode == 'listes' ? 'Listes candidates au ' : 'Résultats du ' }}{{ tour.titre|lower }} {{ nom_a }}</div>
        {% if tour.mode == 'resultats' and tour.cle == 't2' and tour.pct_saisis is not null and tour.pct_saisis < 100 %}
          <div class="alert alert-warning py-2 mb-3">
            Résultats provisoires : dépouillement en cours ({{ tour.pct_saisis|number_format(0, ',', ' ') }}%)
          </div>
        {% endif %}
        {% if tour.mode == 'resultats' and tour.participation is not null %}
          {% set p = tour.participation %}
          <div class="election-stats d-flex mb-3 pb-3">
            <div class="election-stat">
              <span class="election-stat-label">Inscrits</span>
              <span class="election-stat-value">{{ p.inscrits|number_format(0, '.', nbsp) }}</span>
            </div>
            <div class="election-stat-divider mx-3"></div>
            <div class="election-stat">
              <span class="election-stat-label">Votants</span>
              <span class="election-stat-value">{{ p.votants|number_format(0, '.', nbsp) }}</span>
            </div>
            <div class="election-stat-divider mx-3"></div>
            <div class="election-stat">
              <span class="election-stat-label">Abstention</span>
              <span class="election-stat-value">{{ p.abstention|number_format(2, ',', ' ') }}%</span>
            </div>
            <div class="election-stat-divider mx-3"></div>
            <div class="election-stat">
              <span class="election-stat-label">Blancs et nuls</span>
              <span class="election-stat-value">{{ p.blancs_nuls|number_format(0, '.', nbsp) }}</span>
            </div>
          </div>
        {% endif %}

        {% if tour.mode == 'resultats' and tour.resultats is not empty %}
          {% for liste in tour.resultats %}
            <div class="candidate-row d-flex flex-wrap align-items-start py-2">
              <div class="col-8 order-1 col-lg-6 order-lg-1 px-0 mb-1 mb-lg-0" style="min-width: 0;">
                <div class="d-flex align-items-center">
                  <div class="partie-dot mr-3 flex-shrink-0" style="background-color: {{ liste.couleur }};"></div>
                  <div>
                    <div class="font-weight-bold">
                      {{ liste.nom_complet }}
                      {# « 1 siège » et non « 1 sièges » : le site n'accorde
                         pas, faute corrigée ici. #}
                      {% if liste.sieges and (tour.cle == 't2' or tour.pourvu) %}
                        <span class="badge badge-primary ml-1">{{ liste.sieges }} siège{{ liste.sieges > 1 ? 's' }}</span>
                      {% elseif tour.cle == 't1' and not tour.pourvu and liste.situation %}
                        {% if liste.situation == 'maintien' %}
                          <span class="badge badge-success ml-1">Maintien</span>
                        {% elseif liste.situation == 'fusion' %}
                          <span class="badge badge-warning ml-1">Fusion</span>
                        {% else %}
                          <span class="badge badge-secondary ml-1">Désistement</span>
                        {% endif %}
                      {% endif %}
                    </div>
                    {% if liste.code_nuance %}
                      <div style="font-weight: 600">{{ liste.nuance }}</div>
                    {% endif %}
                  </div>
                </div>
              </div>

              <div class="col-4 order-2 col-lg-2 order-lg-3 px-0 text-right mb-1 mb-md-0">
                <div class="font-weight-bold">
                  {{ liste.score|number_format(2, ',', ' ') }}%
                </div>
                <small class="text-muted">
                  {{ liste.voix|number_format(0, '.', nbsp) }} vote{{ liste.voix > 1 ? 's' }}
                </small>
              </div>

              <div class="col-12 order-3 col-lg-4 px-0 order-lg-2 ml-lg-0 px-lg-5 align-self-lg-center">
                <div class="progress" style="height: 8px; background-color: #e9ecef">
                  <div
                    class="progress-bar bg-primary"
                    role="progressbar"
                    style="width: {{ liste.barre|number_format(2, '.', '') }}%;"
                    aria-valuenow="{{ liste.barre|number_format(2, '.', '') }}"
                    aria-valuemin="0"
                    aria-valuemax="100"></div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <p class="text-muted mb-0">{{ tour.mode == 'listes' ? 'Aucune liste disponible.' : 'Aucun résultat disponible.' }}</p>
        {% endif %}
      </div>
    </div>
  </div>
{% endfor %}
