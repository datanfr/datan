{# Carte d'un député candidat, variante « active » de
   application/views/deputes/partials/card_home.php : le nom est cliquable, le
   pied nomme le groupe, et un badge dit où en est la candidature.

   Elle ne se confond pas avec `depute/partials/card.html.twig` : celle-ci porte
   deux choses qui n'existent qu'ici — la circonscription briguée sous le nom, et
   le pied qui bascule sur « Ancien député » quand l'intéressé ne siège plus.
   Ce dernier point est le seul de ces pages qui distingue un candidat d'un
   autre : la moitié des candidats aux régionales de 2021 ne sont plus députés.

   Le chargement différé se fait par l'attribut `loading` et non par la classe
   `img-lazy` du site : le plugin jQuery qui la traite n'est pas embarqué. #}
{% set e = candidat.civilite == 'Mme' ? 'e' : '' %}
<div class="card card-depute mx-2">
  {% if candidat.groupe_couleur %}
    <div class="liseret" style="background-color: {{ candidat.groupe_couleur }}"></div>
  {% endif %}
  <div class="card-avatar-depute{{ candidat.legislature_last >= 17 ? '-square' : '-circle' }} card-avatar">
    <img src="{{ photo_depute(candidat) }}" width="130" height="166" loading="lazy" alt="{{ candidat.firstname }} {{ candidat.lastname }}">
  </div>
  <div class="card-body d-flex flex-column align-items-center justify-content-center">
    <div class="mb-3">
      <h3 class="d-block card-title">
        {% if candidat.dpt_slug and candidat.slug %}
          <a href="{{ path('depute_individual', {dptSlug: candidat.dpt_slug, slug: candidat.slug}) }}" class="stretched-link no-decoration">{{ candidat.firstname }} {{ candidat.lastname }}</a>
        {% else %}
          {{ candidat.firstname }} {{ candidat.lastname }}
        {% endif %}
      </h3>
      <span class="d-block">
        {%- if candidat.circonscription -%}
          Candidat{{ e }} à {{ candidat.circonscription }} ({{ candidat.district_id }})
        {%- else -%}
          {{ candidat.departement_nom }}{% if candidat.departement_code %} ({{ candidat.departement_code }}){% endif %}
        {%- endif -%}
      </span>
      {# Tant que l'issue n'est pas connue, le badge dit seulement si la
         rédaction a établi une candidature — et « Non candidat » est une
         information vérifiée, pas une absence de donnée. #}
      {% if candidat.etat == 'elected' %}
        <span class="badge badge-center mt-2 badge-primary">Élu{{ e }}</span>
      {% elseif candidat.etat == 'lost' %}
        <span class="badge badge-center mt-2 badge-danger">Éliminé{{ e }}</span>
      {% elseif candidat.etat == 'second' %}
        <span class="badge badge-center mt-2 badge-primary">Second tour</span>
      {% elseif candidat.candidat %}
        <span class="badge badge-center mt-2 badge-secondary">Candidat{{ e }}</span>
      {% else %}
        <span class="badge badge-center mt-2 badge-danger">Non candidat{{ e }}</span>
      {% endif %}
    </div>
  </div>
  <div class="card-footer d-flex justify-content-center align-items-center">
    {% if candidat.actif %}
      <span>{{ candidat.groupe_libelle|name_group }} ({{ candidat.groupe_abrev }})</span>
    {% else %}
      <span>Ancien{{ e ? 'ne' }} député{{ e }}</span>
    {% endif %}
  </div>
</div>
