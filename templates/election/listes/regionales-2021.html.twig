<div class="row mt-5 mb-3">
  <div class="col-12">
    <h2>Découvrez les députés candidats aux {{ election.libelle|lower }} de {{ election.annee }}</h2>
  </div>
  <div class="col-12 d-flex flex-column flex-lg-row">
    <div class="d-flex flex-even px-2">
      <div class="d-flex align-items-center">
        <span class="candidatsN">{{ compteurs.candidats }}</span>
      </div>
      <div class="d-flex align-items-center ml-1">
        <span>députés candidats au <b>premier tour</b></span>
      </div>
    </div>
    {% if election.etat > 0 %}
      <div class="d-flex flex-even px-2">
        <div class="d-flex align-items-center">
          <span class="candidatsN">{{ compteurs.second_tour }}</span>
        </div>
        <div class="d-flex align-items-center ml-1">
          <span>députés maintenus pour le <b>second tour</b></span>
        </div>
      </div>
    {% endif %}
    {% if election.etat > 1 %}
      <div class="d-flex flex-even px-2">
        <div class="d-flex align-items-center">
          <span class="candidatsN">{{ compteurs.elus }}</span>
        </div>
        <div class="d-flex align-items-center ml-1">
          <span><b>députés élus</b></span>
        </div>
      </div>
    {% endif %}
  </div>
</div>
<div class="row">
  <div class="pb-4 col-lg-3 search-element sticky-top sticky-top-lg">
    <div class="sticky-top sticky-offset">
      <div class="mt-3 mt-lg-0">
        <input type="text" id="quicksearch" placeholder="Recherchez un député..." />
      </div>
      {# Sur cette page, le menu des régions est dans le même bloc que les
         boutons radio, et non dans un second : c'est la mise en page du site. #}
      <div class="filters stateChange mt-md-5 d-none d-lg-block">
        {% for etat in [
          {'id': 100, 'valeur': '*', 'libelle': 'Tous les députés', 'gras': true},
          {'id': 101, 'valeur': '.elected', 'libelle': 'Élu', 'gras': false},
          {'id': 102, 'valeur': '.lost', 'libelle': 'Éliminé', 'gras': false},
        ] %}
          <input class="radio-btn" name="state" id="radio-{{ etat.id }}" type="radio"{{ loop.first ? ' checked=""' }} value="{{ etat.valeur }}">
          <label for="radio-{{ etat.id }}" class="radio-label d-flex align-items-center">
            <span class="d-flex align-items-center">{% if etat.gras %}<b>{{ etat.libelle }}</b>{% else %}{{ etat.libelle }}{% endif %}</span>
          </label>
        {% endfor %}
        <p class="surtitre mt-5">Filtrer les candidats par région</p>
        <select class="custom-select filters" id="districtChange" onchange="districtChange()">
          <option selected value="*">Tous les députés</option>
          {% for district in districts %}
            <option value=".{{ district.id|lower }}">{{ district.libelle }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
  </div>
  {{ include('election/partials/grille_candidats.html.twig') }}
</div>
