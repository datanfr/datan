{% set n = compteurs.candidats %}
{% set s = n > 1 ? 's' : '' %}
<div class="row mt-5 mb-3">
  <div class="col-12">
    <h2>Découvrez la <span class="font-weight-bold text-primary">candidature des députés</span> aux {{ election.libelle|lower }} de {{ election.annee }}</h2>
  </div>
  <div class="col-lg-9 mt-3">
    <p>Notre équipe a répertorié {{ n }} député{{ s }} ou ancien{{ s }} député{{ s }} candidat{{ s }} aux élections législatives de 2024. Si un député n'est pas dans la liste, n'hésitez pas à nous envoyer un email : info@datan.fr</p>
  </div>
  <div class="col-12 d-flex flex-column flex-lg-row">
    <div class="d-flex flex-even px-2">
      <div class="d-flex align-items-center">
        <span class="candidatsN">{{ n }}</span>
      </div>
      <div class="d-flex align-items-center ml-1">
        <span>député{{ s }} <b>candidat{{ s }} à leur réélection</b></span>
      </div>
    </div>
    {% if election.etat > 0 %}
      <div class="d-flex flex-even px-2">
        <div class="d-flex align-items-center">
          <span class="candidatsN">{{ compteurs.second_tour }}</span>
        </div>
        <div class="d-flex align-items-center ml-1">
          <span>maintenu{{ compteurs.second_tour > 1 ? 's' }} pour le <b>second tour</b></span>
        </div>
      </div>
      <div class="d-flex flex-even px-2">
        <div class="d-flex align-items-center">
          <span class="candidatsN">{{ compteurs.elimines }}</span>
        </div>
        <div class="d-flex align-items-center ml-1">
          <span><b>éliminé{{ compteurs.elimines > 1 ? 's' }}</b></span>
        </div>
      </div>
      <div class="d-flex flex-even px-2">
        <div class="d-flex align-items-center">
          <span class="candidatsN">{{ compteurs.elus }}</span>
        </div>
        <div class="d-flex align-items-center ml-1">
          <span><b>élu{{ compteurs.elus > 1 ? 's' }}</b></span>
        </div>
      </div>
    {% endif %}
  </div>
</div>
<div class="row">
  <div class="pb-4 col-lg-3 search-element sticky-top sticky-top-lg">
    <div class="sticky-top sticky-offset">
      <div class="mt-3 mt-lg-0">
        <input type="text" id="quicksearch" placeholder="Rechercher un député..." />
      </div>
      <div class="filters stateChange mt-md-5 d-none d-lg-block">
        {% for etat in [
          {'id': 200, 'valeur': '*', 'libelle': 'Tous les députés'},
          {'id': 201, 'valeur': '.candidate', 'libelle': 'Députés candidats'},
          {'id': 202, 'valeur': '.not-candidate', 'libelle': 'Députés non candidats'},
          {'id': 204, 'valeur': '.elected', 'libelle': 'Députés élus'},
          {'id': 205, 'valeur': '.lost', 'libelle': 'Députés éliminés'},
        ] %}
          <input class="radio-btn" name="state" id="radio-{{ etat.id }}" type="radio"{{ loop.first ? ' checked' }} value="{{ etat.valeur }}">
          <label for="radio-{{ etat.id }}" class="radio-label d-flex align-items-center">
            <span class="d-flex align-items-center"><b>{{ etat.libelle }}</b></span>
          </label>
        {% endfor %}
      </div>
      <div class="filters stateChange mt-md-3 d-none d-lg-block">
        <p class="surtitre mt-3">Filtrer par département</p>
        <select class="custom-select filters" id="districtChange" onchange="districtChange()">
          <option selected value="*">Tous les députés</option>
          {% for district in districts %}
            <option value=".{{ district.id|lower }}">{{ district.libelle }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
  </div>
  {{ include('election/partials/grille_candidats.html.twig') }}
</div>
