{# La lettre mensuelle des votes, en MJML : réunion des trois vues
   `newsletterTemplates/templates/header.php`, `votes/body.php` et
   `templates/footer.php` du legacy, compilée par {@see App\Newsletter\LettreVotes}.

   Les adresses sont absolues et suivent DEFAULT_URI : une lettre d'essai
   partie de la préproduction pointe la préproduction. Le lien de gestion des
   abonnements se bâtit à la main — `url()` encoderait `[[EMAIL_TO]]`, que
   Mailjet ne reconnaîtrait plus pour y substituer l'adresse du destinataire. #}
{% set accueil = url('home') %}
{% set lien_soutenir = url('page_soutenir') %}
<mjml owa="desktop" version="4.10.1">
  <mj-head>
    <mj-preview>
      Découvrez le site Datan
    </mj-preview>
    <mj-font name="Open Sans" href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,800" />
    <mj-font name="Verdana" href="https://fonts.googleapis.com/css?family=Verdana" />
    <mj-attributes>
      <mj-class name="big" font-size="20px" />
      <mj-all font-family="Open Sans, Verdana" font-size="14px" line-height="1.8" />
      <mj-button background-color="transparent" color="#00B794" border="1px solid #00B794" font-weight="800" border-radius="5px" inner-padding="10px 20px" />
      <mj-section padding="20px 15px" />
    </mj-attributes>
    <mj-title>{{ titre }}</mj-title>
    <mj-style inline="inline">
      .title {
        color: #00b794;
        font-size: 38px;
        font-weight: 800;
        line-height: 1.3;
      }
      .subtitle {
        color: #aaa;
        font-size: 16px;
      }
      .text-black{
        color: #4C4C4C;
      }
      .text-grey{
        color: #4D5755;
      }
      .primary{
        color: #00B794;
      }
      .badge{
        padding: 7px 11px;
        color: #fff;
        border-radius: 4px;
        font-weight: 800;
      }
      .badge-adopté{
        background-color: #00B794;
      }
      .badge-rejeté{
        background-color: #C5283D;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F4F4" color="#5e6977">
    <mj-section background-color="transparent" background-repeat="no-repeat" padding="20px 0px 20px 0px" text-align="center" vertical-align="top">
      <mj-column vertical-align="top">
        <mj-image align="center" alt="Logo Datan" border="none" container-background-color="#00b794" height="auto" href="{{ accueil }}" padding-left="25px" padding-right="25px" padding="10px 25px 10px 25px" src="https://x91ms.mjt.lu/tplimg/x91ms/b/szioh/uqz8.png" target="_blank" title="" vertical-align="top" width="1200px"></mj-image>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" background-repeat="repeat" background-size="auto">
      <mj-column vertical-align="top">
        <mj-text>
          <span class="title">Les derniers votes de l'Assemblée nationale</span>
        </mj-text>
        <mj-text padding-top="0">
          <span class="subtitle">{{ mois|ucfirst }} {{ annee }}</span>
        </mj-text>
        <mj-text padding-top="40px">
          Il y a eu <b>{{ votes_total }} {{ votes_total == 1 ? 'vote' : 'votes' }}</b> à l'Assemblée nationale en {{ mois }} {{ annee }}. {{ bilan }}
        </mj-text>
        <mj-text>
          <b>L'équipe de Datan a sélectionné et <span class="primary">décrypté {{ votes_decryptes }} vote{{ votes_decryptes > 1 ? 's' }}</span></b>.
          {% if importants %}
            Découvrez dans cette newsletter les votes les plus importants !
          {% else %}
            Découvrez-le{{ votes_decryptes > 1 ? 's' }} ci-dessous !
          {% endif %}
        </mj-text>
        <mj-text padding-bottom="40px">
          💶 <b>Soutenez-nous</b> : aidez Datan à rendre l’action des députés accessible à toutes et tous ! <a href="{{ lien_soutenir }}" target="_blank" style="color:#00b794; text-decoration:underline;">Cliquez ici pour faire un don</a>
        </mj-text>
      </mj-column>
    </mj-section>

    {% for vote in votes %}
      {% set lien = absolute_url(lien_vote(vote.legislature, vote.numero)) %}
      <mj-section padding-top="0" background-color="#ffffff" background-repeat="repeat" background-size="auto">
        <mj-column vertical-align="top">
          <mj-divider padding-bottom="40px" border-width="5px" border-style="solid" border-color="lightgrey" />
          <mj-text font-size="22px" font-weight="800" line-height="1.5" padding-bottom="0">
            {{ vote.titre }}
          </mj-text>
          <mj-text font-size="14px" font-weight="400" color="#aaa">
            {{ vote.date_scrutin|date_abregee }}
          </mj-text>
          <mj-text font-size="14px">
            <span class="badge badge-{{ vote.sort_code }}"><b>{{ vote.sort_code|upper }}</b></span>
          </mj-text>
          <mj-text>
            Ce vote a été {{ vote.sort_code }}. Sur les {{ vote.nombre_votants }} parlementaires ayant pris part au vote, {{ vote.nombre_pour }} ont voté pour et {{ vote.nombre_contre }} ont voté contre.
          </mj-text>
          <mj-text font-size="16px" font-weight="800" padding-bottom="0">
            <span class="primary">Les groupes ayant voté pour</span>
          </mj-text>
          <mj-section padding-top="0" padding-bottom="0">
            <mj-group>
              {% for groupe in vote.groupes_pour %}
                <mj-column width="20%">
                  <mj-image padding="5px 10px" alt="{{ groupe.libelle|name_group }}" href="{{ url('groupe_individual', {legislature: vote.legislature, abrev: groupe.libelle_abrev|lower}) }}" src="{{ absolute_url(asset('assets/imgs/groupes/' ~ vote.legislature ~ '/' ~ groupe.libelle_abrev ~ '.png')) }}" />
                </mj-column>
              {% endfor %}
            </mj-group>
          </mj-section>
          {% if vote.contexte != '' %}
            <mj-text font-size="16px" font-weight="800" padding-bottom="0" padding-top="20px">
              <span class="primary">Le contexte du vote</span>
            </mj-text>
            <mj-text padding-top="0">
              {{ vote.contexte }}
              <a href="{{ lien }}" target="_blank">Lire plus</a>
            </mj-text>
          {% endif %}

          <mj-button padding-top="40px" padding-bottom="30px" href="{{ lien }}">
            Découvrez le vote sur Datan
          </mj-button>
        </mj-column>
      </mj-section>
    {% endfor %}

    <mj-section padding="10px 0"></mj-section>

    {% if depute %}
      {% set lien_depute = url('depute_individual', {dptSlug: depute.dpt_slug, slug: depute.slug}) %}
      <mj-section background-color="#ffffff" background-repeat="no-repeat" background-size="auto" border="2px solid #00b794">
        <mj-column width="100%">
          <mj-text font-size="22px" font-weight="800">
            <span class="primary">{{ depute.le|ucfirst }} {{ depute.depute }} qui a le plus participé</span>
          </mj-text>
        </mj-column>
        <mj-column width="30%" vertical-align="middle">
          <mj-image width="200px" border-radius="5px" alt="{{ depute.firstname }} {{ depute.lastname }}" src="{{ absolute_url(photo_depute(depute)) }}" href="{{ lien_depute }}" />
        </mj-column>
        <mj-column width="70%" vertical-align="middle">
          <mj-text>
            <a href="{{ lien_depute }}" target="_blank">{{ depute.firstname }} {{ depute.lastname }}</a> est {{ depute.le }} {{ depute.depute }} qui a le plus participé aux scrutins en {{ mois }} {{ annee }}.
            Avec un <b>taux de participation de {{ depute.score }} %</b>, {{ depute.pronom }} a participé au total à {{ depute.votes }} votes dans l'hémicycle.
          </mj-text>
        </mj-column>
        <mj-column width="100%">
          <mj-button background-color="#00b794" color="#fff" font-weight="800" padding-top="20px" padding-bottom="10px" href="{{ lien_depute }}">
            Découvre son activité
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="10px 0"></mj-section>
    {% endif %}

    <mj-section background-color="#00668E" background-repeat="no-repeat" background-size="auto">
      <mj-column vertical-align="top" width="100%">
        <mj-text font-size="22px" font-weight="800" color="#fff">
          Soutenez-nous : faites un don sur Datan !
        </mj-text>
        <mj-text color="#fff">
          Datan est un <b>outil indépendant</b> visant à rendre accessible l'activité des députés.
        </mj-text>
        <mj-text color="#fff">
          Pour continuer, on a besoin de vous ! Soutenez Datan pour faire vivre la transparence démocratique et l'accès aux données parlementaires.
        </mj-text>
      </mj-column>
      <mj-column width="100%">
        <mj-button background-color="#00b794" color="#fff" font-weight="800" padding-top="20px" padding-bottom="10px" href="{{ lien_soutenir }}">
            Faire un don
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="10px 0"></mj-section>

    <mj-section background-color="#ffffff" background-repeat="no-repeat" background-size="auto">
      <mj-column vertical-align="top">
        <mj-text font-size="22px" font-weight="800">
          <span class="primary">Contribuez au projet 👨‍💻 🔨</span>
        </mj-text>
        <mj-text>
          Datan est géré par <b>une équipe de bénévoles</b>. Notre objectif ? Rendre l'activité parlementaire plus accessible et compréhensible !
        </mj-text>
        <mj-text>
          {# « souhaite » : accord manqué du legacy, corrigé. #}
          Vous avez un don pour coder ou pour le design ? Vous êtes un mordu de politique et souhaitez expliquer certains votes de l'Assemblée ?
        </mj-text>
        <mj-text>
          Contactez-nous : <a href="mailto:info@datan.fr">info@datan.fr</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-repeat="repeat" background-size="auto" padding-left="0px" padding-right="0px" padding="20px 0px 20px 0px" text-align="center" vertical-align="top">
      <mj-column>
        <mj-button align="center" background-color="#00b794" border-radius="3px" border="none" color="#ffffff" font-family="Arial, sans-serif" font-size="16px" font-weight="normal" href="{{ accueil }}" inner-padding="10px 25px 10px 25px" padding-left="25px" padding-right="25px" padding="10px 25px 10px 25px" text-decoration="none" text-transform="none" vertical-align="middle">
          <span style="font-size:16px;text-align:center;background-color:#00b794;color:#ffffff;font-family:Open Sans;"><b>Découvre les votes de ton député !</b></span>
        </mj-button>
        <mj-social align="center" font-family="Ubuntu, Helvetica, Arial, sans-serif" font-size="13px" icon-padding="0px 0px 0px 0px" icon-size="20" line-height="22px" mode="horizontal" padding-left="25px" padding-right="25px" padding="10px 25px 10px 25px" text-decoration="none" text-mode="false">
          <mj-social-element background-color="#3B5998" href="https://www.facebook.com/datanFR" name="facebook-noshare" src="https://www.mailjet.com/images/theme/v1/icons/ico-social/facebook.png"></mj-social-element>
          <mj-social-element background-color="#000000" href="https://x.com/datanFR" name="twitter-noshare" src="https://www.mailjet.com/images/theme/v1/icons/ico-social/twitter-x.png"></mj-social-element>
          <mj-social-element background-color="#1DA1F2" href="https://www.linkedin.com/company/datanfr" name="linkedin-noshare" src="https://www.mailjet.com/images/theme/v1/icons/ico-social/linkedin.png"></mj-social-element>
          <mj-social-element href="https://www.instagram.com/datanfr/" name="instagram-noshare" src="https://www.mailjet.com/images/theme/v1/icons/ico-social/instagram-colored.png"></mj-social-element>
          <mj-social-element background-color="#0886FE" href="https://bsky.app/profile/datanfr.bsky.social" name="instagram-noshare" src="https://www.mailjet.com/images/theme/v1/icons/ico-social/bluesky.png"></mj-social-element>
          <mj-social-element background-color="#4078C0" href="https://github.com/datanfr/datan" name="github-noshare" src="https://www.mailjet.com/images/theme/v1/icons/ico-social/github.png"></mj-social-element>
        </mj-social>
        <mj-text align="left" color="#000000" font-family="Arial, sans-serif" font-size="13px" letter-spacing="normal" padding-bottom="0px" padding-left="25px" padding-right="25px" padding-top="0px" padding="0px 25px 0px 25px">
          <p class="text-build-content" style="text-align: center; margin: 10px 0; margin-top: 10px; margin-bottom: 10px;"><span style="color:#55575d;font-family:Open Sans;font-size:13px;">Pour gérer vos abonnements aux newsletters de Datan, </span><a class="link-build-content" style="color:inherit;" target="_blank" href="{{ accueil }}newsletter/edit/[[EMAIL_TO]]"><span style="color:#55575d;font-family:Open Sans;font-size:13px;">cliquez ici</span></a><span style="color:#55575d;font-family:Open Sans;font-size:13px;">.</span></p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
