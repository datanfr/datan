{# Reprise de `views/newsletter/edit_success.php`. Le bouton « Retour » y
   pointait `base_url() . "/newsletter/…"`, soit un double `//` dans l'adresse :
   corrigé. #}
{% extends 'base.html.twig' %}

{% block robots %}noindex, nofollow{% endblock %}

{% block title %}Gestion des abonnements aux newsletters | Datan{% endblock %}

{% block meta_description %}Mettez à jour vos abonnements aux différentes newsletters de Datan.{% endblock %}

{% block body %}
<div class="container-fluid pg-depute-all" id="container-always-fluid">
  <div class="row">
    <div class="container">
      <div class="row row-grid bloc-titre">
        <div class="col-lg-6 mb-4 mb-lg-0">
          <h1>Mettre à jour vos abonnements</h1>
        </div>
      </div>
      <div class="row mb-4">
        <div class="col-lg-6 mb-4 mb-lg-0">
          <p><b>Félicitations !</b> Vous avez mis à jour vos abonnements aux newsletters de Datan.</p>
          <div class="d-flex justify-content-around my-5">
            <a href="{{ path('newsletter_modifier', {email: abonne.email}) }}" class="btn btn-warning">Retour</a>
            <a href="{{ path('home') }}" class="btn btn-primary">Découvrez Datan !</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
