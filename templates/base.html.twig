    {% block javascripts_libraries %}{% endblock %}
    <script src="{{ asset('assets/js/libraries/jquery/jquery.unveil.min.js') }}"></script>

    {% block javascripts %}{% endblock %}
    <script type="text/javascript" src="{{ asset('assets/js/main.min.js') }}"></script>
    {# Décodeur des adresses masquées aux robots ({{ url_obf(...) }}) — chargé
       partout, comme sur le site : des liens masqués existent jusque dans les
       pieds de page. `robots.txt` interdit ce fichier aux moteurs. #}
    <script type="text/javascript" src="{{ asset('assets/js/datan/url_obf2.min.js') }}"></script>
    {# Compteur de pages du mois, repris du site (footer.php:241-242 depuis le
       10 septembre 2026, commit 6ad583ac) : il remplace le service
       « datantracking » de Tarte au citron, parti avec GTM le même jour. Le
       compte vit en localStorage, hors consentement — le site ne dépose plus
       aucun cookie de son propre chef. Au-delà de 10 pages, la modale de dons
       (partials/modale_don.html.twig) s'ouvre, au plus une fois par semaine.
       Le compteur de pied de page (#monthly-pages-visited-count) n'existe dans
       aucune vue, ici comme là-bas : le script le garde par un `if`. #}
    <script type="text/javascript" src="{{ asset('assets/js/datan/donation-modal-localstorage.js') }}"></script>
