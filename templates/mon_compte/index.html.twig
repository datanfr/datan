{# « Mon compte », porté de `views/users/mon-compte.php`. Contrairement aux pages
   de connexion et d'inscription, celle-ci porte la barre de navigation du site :
   le legacy y charge `templates/header` (navbar) et non `header_no_navbar`. #}
{% extends 'base.html.twig' %}

{% block robots %}noindex, nofollow{% endblock %}
{% block title %}Gérer mon compte{% endblock %}

{% set type_compte = app.user.estDepute ? 'Député'
   : (app.user.estAdmin ? 'Administrateur'
   : (app.user.estLecteur ? 'Lecteur' : 'Rédaction')) %}

{% block body %}
  <div class="container-fluid bloc-img-deputes bloc-img d-flex async_background" id="container-always-fluid"></div>
  <div class="container pg-compte p-5" style="margin-top: -100px; top: 100px;">
    <div class="row">
      <div class="col-12">
        {# Le titre de la page porte le pseudo (`'Gérer mon compte - ' . username`),
           là où l'onglet s'en tient à « Gérer mon compte | Datan ». #}
        <h1 class="mb-5">Gérer mon compte - {{ app.user.identifiant }}</h1>
        {% for message in app.flashes('succes') %}
          <div class="alert alert-success mb-4 text-center" role="alert">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('erreur') %}
          <div class="alert alert-danger mb-4 text-center" role="alert">{{ message }}</div>
        {% endfor %}
      </div>
      <div class="col-12">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title font-weight-bold h5">Mes données personnelles</h2>
            <p class="mb-0">Email : {{ app.user.email }}</p>
            <p class="mb-0">Pseudo : {{ app.user.identifiant }}</p>
            {# Le site étiquette ce champ « Prénom » alors qu'il porte le nom complet
               saisi à l'inscription, sous le libellé « Nom » et l'exemple « Jean
               Dupont » : c'est l'étiquette d'ici qui est fausse, pas la donnée. #}
            <p class="mb-0">Nom : {{ app.user.nom }}</p>
            {# Seul le lecteur renseigne un code postal ; le site affiche la ligne à
               tout le monde, vide pour un député comme pour la rédaction. #}
            {% if app.user.estLecteur %}
              <p class="mb-0">Code postal : {{ app.user.codePostal }}</p>
            {% endif %}
            {# Le legacy affichait le `type` brut ('', 'mp', 'admin') ; on rend un
               libellé lisible — défaut d'affichage corrigé. #}
            <p>Type de compte : {{ type_compte }}</p>
            <div class="mt-3">
              <a href="{{ path('mon_compte_donnees') }}" class="card-link">Modifier</a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 mt-4">
        <div class="card">
          <div class="card-body">
            <h2 class="card-title font-weight-bold h5">Mon mot de passe</h2>
            <p class="mb-0">●●●●●●●●●</p>
            <div class="mt-3">
              <a href="{{ path('mon_compte_mot_de_passe') }}" class="card-link">Modifier</a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 mt-4">
        <a class="btn btn-danger" href="{{ path('mon_compte_supprimer') }}">Supprimer mon compte</a>
      </div>
    </div>
  </div>
{% endblock %}
