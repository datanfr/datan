{# Modification des données personnelles, portée de
   `views/users/modify-personal-data.php`. Le code postal n'est demandé qu'au
   lecteur : un député ou un rédacteur ne le renseigne pas. #}
{% extends 'base.html.twig' %}

{% block robots %}noindex, nofollow{% endblock %}
{% block title %}Modifier mes données personnelles{% endblock %}

{% block body %}
  <div class="container-fluid bloc-img-deputes bloc-img d-flex async_background" id="container-always-fluid"></div>
  <div class="container pg-compte p-5" style="margin-top: -100px; top: 100px;">
    <div class="row">
      <div class="col-12 mb-5">
        <h1>Modifier mes données personnelles</h1>
        <a href="{{ path('mon_compte') }}">Retour vers mon compte</a>
      </div>
      <div class="col-12">
        {% for message in app.flashes('erreur') %}
          <div class="alert alert-danger mb-4 text-center" role="alert">{{ message }}</div>
        {% endfor %}
        <form method="post">
          <input type="hidden" name="_token" value="{{ csrf_token('mon_compte_donnees') }}">
          <div class="login_form">
            <div class="form-group">
              <label class="font-weight-bold">Email *</label>
              <input type="email" class="form-control" name="email" value="{{ app.user.email }}" required>
            </div>
            <div class="form-group">
              <label class="font-weight-bold">Pseudo *</label>
              <input type="text" class="form-control" name="pseudo" value="{{ app.user.identifiant }}" required>
            </div>
            <div class="form-group">
              <label class="font-weight-bold">Nom *</label>
              <input type="text" class="form-control" name="name" value="{{ app.user.nom }}" required>
            </div>
            {% if app.user.estLecteur %}
              <div class="form-group">
                <label class="font-weight-bold">Code postal *</label>
                <input type="text" class="form-control" name="zipcode" value="{{ app.user.codePostal }}" required>
              </div>
            {% endif %}
            <button type="submit" class="btn btn-primary">Sauvegardez</button>
            <a href="{{ path('mon_compte') }}" class="btn btn-secondary">Annuler</a>
          </div>
        </form>
        <p class="mt-3 font-italic">* Champs obligatoires</p>
      </div>
    </div>
  </div>
{% endblock %}
